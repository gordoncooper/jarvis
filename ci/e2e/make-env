#!/usr/bin/env python3
"""Make a throwaway env from envs/env-00 for the e2e job, in this checkout.

Its root source is this repository at --ref, the branch the job pushes with the env on it, and
its core source the same repository at --core-ref (default --ref; a release tag on a tag run).
It hosts env-00's apps, each at its pinned tag in env-00's values/apps.yaml, from --apps-url; no
add-on and no other optional piece. Secrets are sealed to --key-file, a throwaway age key that
lives only on the runner. Nothing here talks to a cluster. The schema check reads the app files
from APPS_REPO, a checkout of --apps-url with its tags.

  ci/e2e/make-env --env e2e --repo-url https://github.com/<owner>/<repo> --ref refs/heads/<branch> \
    --apps-url https://github.com/<owner>/<apps repo> --key-file <path> --node <node>
"""

from __future__ import annotations

import argparse
import shutil
import subprocess
import sys
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parents[2]
EXAMPLE = "env-00"


def _run(*argv: str) -> None:
    subprocess.run(argv, cwd=ROOT, check=True)


def _set(path: Path, values: dict[str, str]) -> None:
    lines = path.read_text(encoding="utf-8").splitlines()
    for key, value in values.items():
        hits = [i for i, line in enumerate(lines) if line.startswith(f"{key}:")]
        if len(hits) != 1:
            raise SystemExit(f"{path}: expected one {key} line, found {len(hits)}")
        lines[hits[0]] = f"{key}: {value}"
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--env", required=True)
    parser.add_argument("--repo-url", required=True)
    parser.add_argument("--ref", required=True)
    parser.add_argument("--core-ref", help="The core source's ref (default: --ref)")
    parser.add_argument("--apps-url", required=True, help="The apps repository the env's apps come from")
    parser.add_argument("--app-dns", action="store_true", help="Turn App DNS on (env-00 lists it); off by default")
    parser.add_argument("--key-file", required=True, type=Path)
    parser.add_argument("--node", required=True, help="The cluster's one node name, the env's one host")
    args = parser.parse_args(argv)
    env_dir = ROOT / "envs" / args.env
    if env_dir.exists():
        raise SystemExit(f"{env_dir} exists")
    shutil.copytree(ROOT / "envs" / EXAMPLE, env_dir)
    for path in env_dir.rglob("*.yaml"):
        text = path.read_text(encoding="utf-8")
        if EXAMPLE in text:
            path.write_text(text.replace(EXAMPLE, args.env), encoding="utf-8")

    _set(env_dir / "values" / "cluster-vars.yaml", {
        "flux_git_repo_url": args.repo_url,
        "flux_git_ref": args.ref,
        "core_git_repo_url": args.repo_url,
        "core_git_ref": args.core_ref or args.ref,
        "age_key_file": str(args.key_file),
        "apps_git_repo_url": args.apps_url,
    })
    # flux/sync.yaml renders from these values with the rest of the wiring, below.

    # One node holds every role a single-node env needs.
    (env_dir / "inventory" / "hosts.yml").write_text(
        f"all:\n  hosts:\n    {args.node}:\n      node_roles: [control_plane, backup, edge]\n", encoding="utf-8")

    # env-00's hosted apps at their pins, and App DNS when asked; no add-on and no other optional piece.
    switches = env_dir / "values" / "switches.yaml"
    apps = yaml.safe_load(switches.read_text(encoding="utf-8"))["apps"]
    optional = ["app-dns", "app-hosting"] if args.app_dns else ["app-hosting"]
    switches.write_text(yaml.safe_dump({"optional": optional, "addons": [], "apps": apps}), encoding="utf-8")

    public = subprocess.run(["age-keygen", "-y", str(args.key_file)], capture_output=True, text=True, check=True).stdout.strip()
    (ROOT / ".sops.yaml").write_text(
        yaml.safe_dump({"creation_rules": [{"path_regex": f"envs/{args.env}/secrets/.*\\.sops\\.yaml$", "age": public}]}),
        encoding="utf-8",
    )
    python = sys.executable
    _run(python, "tools/render", "--env", args.env)
    _run(python, "tools/bootstrap-secrets", "--env", args.env)
    _run(python, "-c", "from jarvis.schema.env import main; raise SystemExit(main())", "--env", args.env)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
