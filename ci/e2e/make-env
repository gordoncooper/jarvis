#!/usr/bin/env python3
"""Make the e2e job's throwaway env in this checkout, as jarvis init writes one.

The env is written by jarvis init's own code (jarvis/env/scaffold.py) with its secrets sealed to
--key-file, a throwaway age key that lives only on the runner, then edited as an owner would:
the sample hosted apps at their pins from --apps-url, and App DNS when asked. Its root source is
this repository at --ref, the branch the job pushes with the env on it, and its core source the
same repository at --core-ref (default --ref; a release tag on a tag run). Nothing here talks to
a cluster. The render reads the app files from APPS_REPO, a checkout of --apps-url with its tags.

  ci/e2e/make-env --env e2e --repo-url https://github.com/<owner>/<repo> --ref refs/heads/<branch> \\
    --apps-url https://github.com/<owner>/<apps repo> --key-file <path> --node <node>
"""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
sys.path[:0] = [str(ROOT), str(ROOT / "ci" / "tests")]

import sample  # noqa: E402

from jarvis.env import scaffold  # noqa: E402
from jarvis.secrets import age  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--env", required=True)
    parser.add_argument("--repo-url", required=True)
    parser.add_argument("--ref", required=True)
    parser.add_argument("--core-ref", help="The core source's ref (default: --ref)")
    parser.add_argument("--apps-url", required=True, help="The apps repository the env's apps come from")
    parser.add_argument("--app-dns", action="store_true", help="Turn App DNS on; off by default")
    parser.add_argument("--key-file", required=True, type=Path)
    parser.add_argument("--node", required=True, help="The cluster's one node name, the env's one host")
    args = parser.parse_args(argv)
    if (ROOT / "envs" / args.env).exists():
        raise SystemExit(f"envs/{args.env} exists")
    spec = scaffold.EnvSpec(
        name=args.env,
        domain=f"{args.env}.example",
        repo_url=args.repo_url,
        branch=args.ref.removeprefix("refs/heads/"),
        core_url=args.repo_url,
        core_tag="",
        core_ref=args.core_ref or args.ref,
        # One node holds every role a single-node env needs.
        nodes=[scaffold.Node.parse(args.node, only=True)],
        ssh_user="e2e",
        features=["app-dns", "app-hosting"] if args.app_dns else ["app-hosting"],
        apps_repo_url=args.apps_url,
        age_key_file=str(args.key_file),
    )
    os.environ["SOPS_AGE_KEY_FILE"] = str(args.key_file)
    # The working key, and a throwaway public key standing in for the offline recovery key.
    keys = [age.public_key(args.key_file), age.new_key_in_memory()[1]]
    sample.add_env_from_spec(ROOT, spec, public_keys=keys, hosts_text=None, with_addons=False)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
