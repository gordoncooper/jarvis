#!/usr/bin/env python3
"""Make a throwaway core-only env from envs/env-00 for the e2e job, in this checkout.

Its root and core sources are both this repository at --ref, so the branch the job pushes
holds the code under test and the env together. Secrets are sealed to --key-file, a throwaway
age key that lives only on the runner. Nothing here talks to a cluster.

  ci/e2e/make-env --env e2e --repo-url https://github.com/<owner>/<repo> --ref refs/heads/<branch> --key-file <path>
"""

from __future__ import annotations

import argparse
import shutil
import subprocess
import sys
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parents[2]
EXAMPLE = "env-00"


def _run(*argv: str) -> None:
    subprocess.run(argv, cwd=ROOT, check=True)


def _set(path: Path, values: dict[str, str]) -> None:
    lines = path.read_text(encoding="utf-8").splitlines()
    for key, value in values.items():
        hits = [i for i, line in enumerate(lines) if line.startswith(f"{key}:")]
        if len(hits) != 1:
            raise SystemExit(f"{path}: expected one {key} line, found {len(hits)}")
        lines[hits[0]] = f"{key}: {value}"
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--env", required=True)
    parser.add_argument("--repo-url", required=True)
    parser.add_argument("--ref", required=True)
    parser.add_argument("--key-file", required=True, type=Path)
    args = parser.parse_args(argv)
    env_dir = ROOT / "envs" / args.env
    if env_dir.exists():
        raise SystemExit(f"{env_dir} exists")
    shutil.copytree(ROOT / "envs" / EXAMPLE, env_dir)
    for path in env_dir.rglob("*.yaml"):
        text = path.read_text(encoding="utf-8")
        if EXAMPLE in text:
            path.write_text(text.replace(EXAMPLE, args.env), encoding="utf-8")

    _set(env_dir / "values" / "cluster-vars.yaml", {
        "flux_git_repo_url": args.repo_url,
        "flux_git_ref": args.ref,
        "core_git_repo_url": args.repo_url,
        "core_git_ref": args.ref,
        "age_key_file": str(args.key_file),
    })
    cluster_vars = env_dir / "values" / "cluster-vars.yaml"
    cluster_vars.write_text("".join(line for line in cluster_vars.read_text(encoding="utf-8").splitlines(keepends=True)
                                    if not line.startswith("apps_git_repo_url:")), encoding="utf-8")
    sync = env_dir / "flux" / "sync.yaml"
    docs = [doc for doc in yaml.safe_load_all(sync.read_text(encoding="utf-8")) if doc]
    for doc in docs:
        if doc.get("kind") == "GitRepository":
            doc["spec"]["url"] = args.repo_url
            doc["spec"]["ref"] = {"name": args.ref}
    sync.write_text(yaml.safe_dump_all(docs, sort_keys=False), encoding="utf-8")

    # Core only: no add-on, no hosted app, no optional piece.
    (env_dir / "values" / "switches.yaml").write_text("optional: []\naddons: []\napps: []\n", encoding="utf-8")
    (env_dir / "values" / "apps.yaml").unlink(missing_ok=True)

    public = subprocess.run(["age-keygen", "-y", str(args.key_file)], capture_output=True, text=True, check=True).stdout.strip()
    (ROOT / ".sops.yaml").write_text(
        yaml.safe_dump({"creation_rules": [{"path_regex": f"envs/{args.env}/secrets/.*\\.sops\\.yaml$", "age": public}]}),
        encoding="utf-8",
    )
    python = sys.executable
    _run(python, "tools/lib/render_switches.py", "--env", args.env)
    _run(python, "tools/bootstrap-secrets", "--env", args.env)
    _run(python, "tools/lib/render_cluster_vars_configmap.py", "--env", args.env,
         "--output", str(env_dir / "flux" / "generated" / "cluster-vars-configmap.yaml"))
    _run(python, "-c", "from schema.env import main; raise SystemExit(main())", "--env", args.env)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
