#!/usr/bin/env bash
# CI rule check: LoadBalancer Services are only Traefik and App DNS (R28).
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

export PYTHONPATH="${repo_root}/ci/checks/lib:${repo_root}${PYTHONPATH:+:${PYTHONPATH}}"

python3 - <<'PY'
from pathlib import Path

from _loadbalancer import format_violations, scan_loadbalancer

violations = scan_loadbalancer(Path("."))
if violations:
    for line in format_violations(violations):
        print(line, flush=True)
    raise SystemExit(1)
PY
