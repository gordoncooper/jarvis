#!/usr/bin/env bash
# CI rule check: LoadBalancer Services are only Traefik and App DNS.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

export PYTHONPATH="${repo_root}${PYTHONPATH:+:${PYTHONPATH}}"

python3 - <<'PY'
from pathlib import Path

from jarvis.checks.loadbalancer import format_violations, scan_loadbalancer

violations = scan_loadbalancer(Path("."), require_roots=True)
if violations:
    for line in format_violations(violations):
        print(line, flush=True)
    raise SystemExit(1)
PY
