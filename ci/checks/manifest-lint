#!/usr/bin/env bash
# CI rule check: workloads set probes, resources, and stdout logs.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

export PYTHONPATH="${repo_root}${PYTHONPATH:+:${PYTHONPATH}}"

python3 - <<'PY'
from pathlib import Path

from jarvis.checks.manifest_lint import format_violations, scan_manifest_lint
from jarvis.schema.env import instance_root

# An instance checkout holds only envs/, so the core roots are not required there.
root = instance_root(Path("."))
violations = scan_manifest_lint(root, require_roots=root == Path("."))
if violations:
    for line in format_violations(violations):
        print(line, flush=True)
    raise SystemExit(1)
PY
