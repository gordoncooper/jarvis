#!/usr/bin/env bash
# CI rule check: Flux's own objects and protected kinds carry prune: disabled, so a bad
# The check itself lives in jarvis/env/validate.py, which jarvis validate runs on an instance.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

export PYTHONPATH="${repo_root}${PYTHONPATH:+:${PYTHONPATH}}"
exec python3 -m jarvis.env.validate --only flux-prune
