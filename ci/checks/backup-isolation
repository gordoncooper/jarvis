#!/usr/bin/env bash
# CI rule check: no hosted app's backup credential reaches core's rest-server or repositories,
# and core's credential never reaches an app (core/platform/backups/CONTRACT.md, App credentials).
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

export PYTHONPATH="${repo_root}${PYTHONPATH:+:${PYTHONPATH}}"

python3 - <<'PY'
from pathlib import Path

from jarvis.checks.backup_isolation import format_violations, scan_backup_isolation
from jarvis.schema.env import instance_root

violations = scan_backup_isolation(instance_root(Path(".")))
if violations:
    for line in format_violations(violations):
        print(line, flush=True)
    raise SystemExit(1)
PY
