#!/usr/bin/env bash
# CI rule check: env schema validation.
# The check itself lives in jarvis/env/validate.py, which jarvis validate runs on an instance.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

# shellcheck source=lib/_apps_repo_env.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/_apps_repo_env.sh"
_apps_repo_prepare "$repo_root" || exit 1

export PYTHONPATH="${repo_root}${PYTHONPATH:+:${PYTHONPATH}}"
exec python3 -m jarvis.env.validate --only env-schema
