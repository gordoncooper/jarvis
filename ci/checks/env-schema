#!/usr/bin/env bash
# CI rule check: env schema validation (R4, framework §5 Env schema).
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

# shellcheck source=lib/_apps_repo_env.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/_apps_repo_env.sh"
_apps_repo_prepare "$repo_root" || exit 1

export PYTHONPATH="${repo_root}${PYTHONPATH:+:${PYTHONPATH}}"

python3 - <<'PY'
from pathlib import Path

from schema.env import ValidationError, instance_root, validate_env_tree

try:
    validate_env_tree(instance_root(Path(".")))
except ValidationError as exc:
    for line in exc.messages:
        print(line, flush=True)
    raise SystemExit(1)
PY
