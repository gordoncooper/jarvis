#!/usr/bin/env bash
# CI rule check: Markdown docs, READMEs and docs/ contain no plan codes, including rulebooks/; not AGENTS.md or .github/.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

export PYTHONPATH="${repo_root}/ci/checks/lib:${repo_root}${PYTHONPATH:+:${PYTHONPATH}}"

python3 - <<'PY'
from pathlib import Path

from _plan_codes import scan_plan_codes

violations = scan_plan_codes(Path("."))
if violations:
    for line in violations:
        print(line, flush=True)
    raise SystemExit(1)
PY
