#!/usr/bin/env bash
# CI rule check: the Cursor and Claude Code deny lists both block every block row
# and allow every allow row of the guard corpus.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

export PYTHONPATH="${repo_root}/ci/checks/lib:${repo_root}${PYTHONPATH:+:${PYTHONPATH}}"

python3 - <<'PY'
from pathlib import Path

from _cli_permissions import check_repo

failures = check_repo(Path("."))
for line in failures:
    print(line, flush=True)
if failures:
    raise SystemExit(1)
print("cli-deny OK: .cursor/cli.json and .claude/settings.json")
PY
