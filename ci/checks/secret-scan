#!/usr/bin/env bash
# CI rule check: pinned gitleaks secret scan.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
gitleaks="${HOME}/.local/bin/gitleaks"

if [[ ! -x "$gitleaks" ]]; then
  echo "secret-scan: gitleaks not found at ${gitleaks} (run: make deps)" >&2
  exit 1
fi

cd "$repo_root"
# INSTANCE points the scan at an instance checkout (jarvis/lib/env.py).
exec "$gitleaks" detect --source "${INSTANCE:-$repo_root}" --redact
