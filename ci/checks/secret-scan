#!/usr/bin/env bash
# CI rule check: pinned gitleaks secret scan.
# On core itself (its core/ and addons/ trees; core holds no env). The check lives in
# jarvis/env/validate.py; sample-instance and jarvis validate run it on an instance.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

export PYTHONPATH="${repo_root}${PYTHONPATH:+:${PYTHONPATH}}"
exec python3 -m jarvis.env.validate --only secret-scan
