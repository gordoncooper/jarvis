#!/usr/bin/env bash
# CI rule check: pinned gitleaks secret scan.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# gitleaks at mise.toml's pin, on PATH from mise (make deps, CI's mise-action).
if ! gitleaks="$(command -v gitleaks)"; then
  echo "secret-scan: gitleaks not on PATH (run make deps, then use make or mise exec)" >&2
  exit 1
fi

cd "$repo_root"
# INSTANCE points the scan at an instance checkout (jarvis/lib/env.py).
exec "$gitleaks" detect --source "${INSTANCE:-$repo_root}" --redact
