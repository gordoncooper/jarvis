#!/usr/bin/env bash
# CI rule check: add-ons plug in through their Component and slot, core never names
# one, and each enabled add-on's tenant identity stays inside its own namespaces.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

export PYTHONPATH="${repo_root}/ci/checks/lib:${repo_root}${PYTHONPATH:+:${PYTHONPATH}}"

python3 - <<'PY'
from pathlib import Path

from _addons import format_violations, scan_addons
from schema.env import instance_root

violations = scan_addons(Path("."), instance_root(Path(".")))
if violations:
    for line in format_violations(violations):
        print(line, flush=True)
    raise SystemExit(1)
PY
