#!/usr/bin/env bash
# CI rule check: each hosted app an env lists gets core's whole wiring (namespace, network
# baseline, admission bindings, the env's grants, tenant identity) and nothing else.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

export PYTHONPATH="${repo_root}${PYTHONPATH:+:${PYTHONPATH}}"

python3 - <<'PY'
from pathlib import Path

from jarvis.checks.app_hosting import format_violations, scan_app_hosting
from jarvis.schema.env import instance_root

violations = scan_app_hosting(instance_root(Path(".")))
if violations:
    for line in format_violations(violations):
        print(line, flush=True)
    raise SystemExit(1)
PY
