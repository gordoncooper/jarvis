#!/usr/bin/env bash
# CI rule check: every env-level check (jarvis validate) on a sample instance built the way
# jarvis init builds one (ci/tests/sample.py). Core ships no env of its own, so this is where
# the env checks meet a whole env; instance repos run the same checks with jarvis validate.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"
export PYTHONPATH="${repo_root}${PYTHONPATH:+:${PYTHONPATH}}"

work="$(mktemp -d)"
trap 'rm -rf "${work}"' EXIT
# The sample's apps are the fixture apps repository, tagged at the versions its env pins; its
# add-on is the fixture one, in the test core the sample is read against.
python3 ci/tests/sample.py --validate "${work}/instance"
