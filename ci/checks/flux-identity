#!/usr/bin/env bash
# CI rule check: every Flux Kustomization and HelmRelease names a service account
# the env's flux tree declares, only the platform objects run as the platform
# account, no Kustomization creates its own account, and refs stay in-namespace.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

export PYTHONPATH="${repo_root}/ci/checks/lib:${repo_root}${PYTHONPATH:+:${PYTHONPATH}}"

python3 - <<'PY'
from pathlib import Path

from _flux_identity import format_violations, scan_flux_identity
from schema.env import instance_root

violations = scan_flux_identity(instance_root(Path(".")))
if violations:
    for line in format_violations(violations):
        print(line, flush=True)
    raise SystemExit(1)
PY
