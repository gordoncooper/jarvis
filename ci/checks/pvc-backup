#!/usr/bin/env bash
# CI rule check: every PVC has a VolSync ReplicationSource or backup: none (R31).
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

export PYTHONPATH="${repo_root}/ci/checks/lib:${repo_root}${PYTHONPATH:+:${PYTHONPATH}}"

python3 - <<'PY'
from pathlib import Path

from _pvc_backup import format_violations, scan_pvc_backup

violations = scan_pvc_backup(Path("."))
if violations:
    for line in format_violations(violations):
        print(line, flush=True)
    raise SystemExit(1)
PY
