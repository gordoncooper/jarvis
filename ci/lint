#!/usr/bin/env bash
# ruff and pyright at the pins in requirements-dev.txt, configured in pyproject.toml.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
VENV="${VENV:-${ROOT}/.venv}"

"${VENV}/bin/ruff" check .
"${VENV}/bin/pyright" --pythonpath "${VENV}/bin/python"
