#!/usr/bin/env python3
"""Download the kubeconform schemas this repo vendors.

Kubernetes: yannh/kubernetes-json-schema standalone-strict files for the
pinned k3s minor, only the kinds a flux-layer kustomize build emits.
VolSync: CRDs from backube/volsync at the Helm chart tag, converted the
same way kubeconform's openapi2jsonschema does (additionalProperties
false on objects).
Other CRDs the render uses: datreeio/CRDs-catalog at CRD_CATALOG_REF.

Hand-written and not refreshed: helm.cattle.io/helmchartconfig_v1.json
and apiextensions.k8s.io/customresourcedefinition_v1.json (neither
upstream set has a usable document for those kinds).

Run from anywhere: python3 ci/tests/fixtures/schemas/refresh
"""

from __future__ import annotations

import json
import shutil
import sys
import urllib.request
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parents[4]
DEST = Path(__file__).resolve().parent

# datreeio/CRDs-catalog commit that includes fluxcd.controlplane.io.
CRD_CATALOG_REF = "3eb90d47aba8d61919d4419dd38301536e32a94b"

# File names match kubeconform's default kubernetes-json-schema layout.
K8S_FILES = (
    "clusterrole-rbac-v1.json",
    "configmap-v1.json",
    "cronjob-batch-v1.json",
    "deployment-apps-v1.json",
    "ingress-networking-v1.json",
    "namespace-v1.json",
    "secret-v1.json",
    "service-v1.json",
)

# {{.Group}}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json
CRD_FILES = (
    "cert-manager.io/certificate_v1.json",
    "cert-manager.io/clusterissuer_v1.json",
    "fluxcd.controlplane.io/fluxinstance_v1.json",
    "helm.toolkit.fluxcd.io/helmrelease_v2.json",
    "kustomize.toolkit.fluxcd.io/kustomization_v1.json",
    "kyverno.io/clusterpolicy_v1.json",
    "source.toolkit.fluxcd.io/helmrepository_v1.json",
    "source.toolkit.fluxcd.io/ocirepository_v1.json",
    "traefik.io/tlsstore_v1alpha1.json",
)

VOLSYNC_CRDS = (
    ("replicationsources.yaml", "replicationsource_v1alpha1.json"),
    ("replicationdestinations.yaml", "replicationdestination_v1alpha1.json"),
)

HAND_WRITTEN = (
    "helm.cattle.io/helmchartconfig_v1.json",
    "apiextensions.k8s.io/customresourcedefinition_v1.json",
)


def _get(url: str) -> bytes:
    request = urllib.request.Request(url, headers={"User-Agent": "jarvis-schema-refresh"})
    with urllib.request.urlopen(request, timeout=60) as response:
        return response.read()


def _k8s_minor() -> str:
    pin = yaml.safe_load((ROOT / "envs/env-00/values/cluster-vars.yaml").read_text())[
        "k3s_version"
    ]
    sys.path.insert(0, str(ROOT))
    from schema.env import kubernetes_version_from_k3s

    version = kubernetes_version_from_k3s(pin)
    if version is None:
        raise SystemExit(f"k3s_version {pin!r} is not a k3s version string")
    return version


def _volsync_tag() -> str:
    doc = yaml.safe_load(
        (ROOT / "platform/backups/controller/helmrelease.yaml").read_text()
    )
    version = doc["spec"]["chart"]["spec"]["version"]
    if not isinstance(version, str) or not version:
        raise SystemExit("VolSync chart version is missing")
    return f"v{version}"


def _write(path: Path, data: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(data)


def additional_properties(node: object) -> None:
    """openapi2jsonschema: objects with properties reject unknown fields."""
    if isinstance(node, dict):
        if "properties" in node and "additionalProperties" not in node:
            node["additionalProperties"] = False
        for value in node.values():
            additional_properties(value)
    elif isinstance(node, list):
        for value in node:
            additional_properties(value)


def refresh_kubernetes(version: str) -> None:
    folder = f"v{version}-standalone-strict"
    for path in DEST.glob("v*-standalone-strict"):
        if path.name != folder:
            shutil.rmtree(path)
    dest = DEST / folder
    dest.mkdir(parents=True, exist_ok=True)
    base = (
        "https://raw.githubusercontent.com/yannh/kubernetes-json-schema/"
        f"master/{folder}"
    )
    for name in K8S_FILES:
        _write(dest / name, _get(f"{base}/{name}"))
        print(f"k8s {folder}/{name}")


def refresh_catalog() -> None:
    base = (
        "https://raw.githubusercontent.com/datreeio/CRDs-catalog/"
        f"{CRD_CATALOG_REF}"
    )
    for rel in CRD_FILES:
        _write(DEST / rel, _get(f"{base}/{rel}"))
        print(f"catalog {rel}")


def refresh_volsync(tag: str) -> None:
    dest = DEST / "volsync.backube"
    dest.mkdir(parents=True, exist_ok=True)
    for crd_name, schema_name in VOLSYNC_CRDS:
        url = (
            "https://raw.githubusercontent.com/backube/volsync/"
            f"{tag}/config/crd/bases/volsync.backube_{crd_name}"
        )
        doc = yaml.safe_load(_get(url))
        versions = doc["spec"]["versions"]
        if len(versions) != 1:
            raise SystemExit(f"{crd_name}: expected one version, got {len(versions)}")
        schema = versions[0]["schema"]["openAPIV3Schema"]
        additional_properties(schema)
        (dest / schema_name).write_text(json.dumps(schema, indent=2) + "\n", encoding="utf-8")
        print(f"volsync {schema_name} from {tag}")


def main() -> None:
    missing = [rel for rel in HAND_WRITTEN if not (DEST / rel).is_file()]
    if missing:
        raise SystemExit(f"hand-written schema missing: {missing}")
    version = _k8s_minor()
    tag = _volsync_tag()
    refresh_kubernetes(version)
    refresh_catalog()
    refresh_volsync(tag)


if __name__ == "__main__":
    main()
