{
  "description": "HelmChartConfig customizes a k3s HelmChart. spec and metadata accept every upstream field; kind and apiVersion stay closed. The filename is lowercase because kubeconform looks the kind up that way.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": ["helm.cattle.io/v1"]
    },
    "kind": {
      "type": "string",
      "enum": ["HelmChartConfig"]
    },
    "metadata": {
      "type": "object",
      "required": ["name", "namespace"],
      "properties": {
        "name": { "type": "string" },
        "namespace": { "type": "string" }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": ["valuesContent"],
      "properties": {
        "valuesContent": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
