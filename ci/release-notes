#!/usr/bin/env python3
"""Print one release's section of CHANGELOG.md (the lines under '## <tag>'), or fail."""

from __future__ import annotations

import sys
from pathlib import Path

CHANGELOG = Path(__file__).resolve().parents[1] / "CHANGELOG.md"


def section(text: str, tag: str) -> str | None:
    lines, found = [], False
    for line in text.splitlines():
        if line.startswith("## "):
            if found:
                break
            found = line[3:].strip() == tag
            continue
        if found:
            lines.append(line)
    body = "\n".join(lines).strip()
    return body or None


def main(argv: list[str]) -> int:
    if len(argv) != 1:
        print("usage: ci/release-notes <tag>", file=sys.stderr)
        return 2
    body = section(CHANGELOG.read_text(encoding="utf-8"), argv[0])
    if body is None:
        print(f"CHANGELOG.md has no '## {argv[0]}' section; add it before tagging", file=sys.stderr)
        return 1
    print(body)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
