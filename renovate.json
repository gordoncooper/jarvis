{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": false,
  "devcontainer": {
    "managerFilePatterns": ["/^jarvis\\/kit\\/devcontainer\\/devcontainer\\.json$/"]
  },
  "packageRules": [
    {
      "description": "The flux CLI (mise.toml) moves with the Flux version core's FluxInstance runs (custom.regex), so an operator's CLI matches the cluster.",
      "groupName": "flux",
      "matchPackageNames": ["fluxcd/flux2"]
    },
    {
      "description": "k3s host binary is pinned in cluster-vars.yaml and changes only by PR, opened after approval in the dependency dashboard. A bump has to re-check core/platform/traefik and update the bundled chart and k3s versions in core/platform/traefik/CONTRACT.md.",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["k3s-io/k3s"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Mover image stays on the VolSync chart minor. The backups contract depends on that minor's behaviour. Raise the cap in the same PR that bumps the chart to the next minor. One PR still updates every mover pin.",
      "groupName": "volsync-image",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["quay.io/backube/volsync"],
      "allowedVersions": "<0.18"
    },
    {
      "description": "The VolumeSnapshot CRD is vendored and nothing updates it. Put the re-check where the reviewer of a VolSync chart bump sees it.",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["volsync"],
      "prBodyNotes": [
        "Re-check `core/platform/backups/controller/volumesnapshot-crd.yaml` against the external-snapshotter client this VolSync release imports."
      ]
    },
    {
      "description": "The restic and rest-server images and the matching CLI pins in mise.toml move in one PR, because the rest-server isolation test requires them equal. Renovate updates mise.lock in the same PR.",
      "groupName": "restic",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["restic/restic", "restic/rest-server"]
    },
    {
      "description": "The restic and rest-server CLIs in mise.toml, grouped with their images (rule above).",
      "groupName": "restic",
      "matchManagers": ["mise"],
      "matchDepNames": ["restic", "github:restic/rest-server"]
    },
    {
      "description": "One PR updates the Kyverno chart, every Kyverno image digest pin and the matching CLI pin in mise.toml (rule below); Renovate updates mise.lock in the same PR.",
      "groupName": "kyverno",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["kyverno", "ghcr.io/kyverno/kyverno", "ghcr.io/kyverno/kyvernopre", "ghcr.io/kyverno/background-controller"]
    },
    {
      "description": "The kyverno CLI in mise.toml, grouped with the chart and images (rule above).",
      "groupName": "kyverno",
      "matchManagers": ["mise"],
      "matchDepNames": ["kyverno"]
    },
    {
      "description": "One PR updates the cert-manager chart and every cert-manager image digest pin.",
      "groupName": "cert-manager",
      "matchManagers": ["custom.regex"],
      "matchDepNames": [
        "cert-manager",
        "quay.io/jetstack/cert-manager-controller",
        "quay.io/jetstack/cert-manager-webhook",
        "quay.io/jetstack/cert-manager-cainjector",
        "quay.io/jetstack/cert-manager-startupapicheck",
        "quay.io/jetstack/cert-manager-acmesolver"
      ]
    },
    {
      "description": "Helm host CLI version and sha256 are bumped together by PR, opened after approval in the dependency dashboard.",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["helm/helm"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "kubectl and the admission test's kube-apiserver (mise.toml) move together and stay on the k3s minor. Raise this cap in the same PR that moves k3s_version to the next minor. A test fails if they drift apart.",
      "groupName": "kubernetes",
      "matchManagers": ["mise"],
      "matchDepNames": ["kubectl", "aqua:kubernetes/kubernetes/kube-apiserver"],
      "allowedVersions": "<1.37"
    },
    {
      "description": "Renovate reads aqua:kubernetes/kubernetes/kube-apiserver as the repository kubernetes/kubernetes/kube-apiserver, which does not exist; its releases are kubernetes/kubernetes's.",
      "matchManagers": ["mise"],
      "matchDepNames": ["aqua:kubernetes/kubernetes/kube-apiserver"],
      "overridePackageName": "kubernetes/kubernetes",
      "extractVersion": "^v(?<version>.+)$"
    },
    {
      "description": "The admission test's loopback etcd is the one kubeadm pairs with kubectl's minor (1.36: etcd 3.6). Raise this cap in the PR that moves kubectl to a minor kubeadm pairs with etcd 3.7.",
      "matchDepNames": ["etcd"],
      "allowedVersions": "<3.7",
      "matchManagers": ["mise"]
    },
    {
      "description": "Python packages in pyproject.toml update as one PR; Renovate updates uv.lock with them. Exact == pins stay exact.",
      "groupName": "python-dev",
      "matchManagers": ["pep621"],
      "matchFileNames": ["pyproject.toml"]
    },
    {
      "description": "ansible 14.x requires ansible-core 2.21.x. Raise this cap in the same PR as an ansible major bump. Patch updates inside 2.21 still flow.",
      "matchManagers": ["pep621"],
      "matchFileNames": ["pyproject.toml"],
      "matchPackageNames": ["ansible-core"],
      "allowedVersions": "<2.22"
    },
    {
      "description": "The devcontainer's base image is pinned by tag; Renovate adds and moves its digest.",
      "matchManagers": ["devcontainer"],
      "pinDigests": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The mise release jdx/mise-action installs (its version input), in the workflows and the app-check Action.",
      "managerFilePatterns": ["/^\\.github\\/(workflows\\/[^/]+|actions\\/[^/]+\\/action)\\.ya?ml$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*version: (?<currentValue>\\S+)"]
    },
    {
      "customType": "regex",
      "description": "Core's k3s release in infra/ansible/group_vars/all.yml, which every env runs unless it overrides it. k3s_sha256 is bumped by hand in the same PR.",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "k3s-io/k3s",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$",
      "managerFilePatterns": ["/^infra\\/ansible\\/group_vars\\/all\\.yml$/"],
      "matchStrings": ["k3s_version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+\\+k3s\\d+)"]
    },
    {
      "customType": "regex",
      "description": "Datasource comments in Ansible defaults and Flux OCIRepository.",
      "managerFilePatterns": ["/^infra\\/ansible\\/roles\\/flux-operator\\/defaults\\/main\\.yml$/", "/^core\\/platform\\/flux-operator\\/oci-repository\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+?) depName=(?<depName>\\S+?)(?: versioning=(?<versioning>\\S+?))?\\s*\\nhelm_version: (?<currentValue>\\S+)",
        "# renovate: datasource=(?<datasource>\\S+?) depName=(?<depName>\\S+?)(?: versioning=(?<versioning>\\S+?))?\\s*\\n\\s*tag: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Flux distribution version in core's FluxInstance (core/flux/flux-instance.yaml), which every env runs at its core tag. A bump merges only after the Flux Operator version that supports it is live, because the operator ships the manifests for each Flux version.",
      "managerFilePatterns": ["/^core\\/flux\\/flux-instance\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+?) depName=(?<depName>\\S+?)(?: versioning=(?<versioning>\\S+?))?\\s*\\n\\s*version:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "VolSync Helm chart pin.",
      "managerFilePatterns": ["/^core\\/platform\\/backups\\/controller\\/helmrelease.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>helm) depName=(?<depName>volsync) registryUrl=(?<registryUrl>\\S+)\\n\\s*version: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "cert-manager Helm chart pin.",
      "managerFilePatterns": ["/^core\\/platform\\/cert-manager\\/controller\\/helmrelease.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>helm) depName=(?<depName>cert-manager) registryUrl=(?<registryUrl>\\S+)\\n\\s*version: \"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "cert-manager component image tag and digest.",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["/^core\\/platform\\/cert-manager\\/controller\\/helmrelease.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>quay\\.io/jetstack/cert-manager-\\S+)\\n\\s*tag: \"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\"\\n\\s*digest: \"(?<currentDigest>sha256:[a-f0-9]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "k8s-gateway OCI chart pin.",
      "managerFilePatterns": ["/^core\\/feature\\/app-dns\\/helmrelease.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+?) depName=(?<depName>\\S+?)(?: versioning=(?<versioning>\\S+?))?\\s*\\n\\s*version: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "k8s_gateway image tag and digest.",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["/^core\\/feature\\/app-dns\\/helmrelease.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>codeberg\\.org/k8s-gateway/k8s_gateway)\\n\\s*tag: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Kyverno Helm chart pin.",
      "managerFilePatterns": ["/^core\\/platform\\/kyverno\\/helmrelease.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>helm) depName=(?<depName>kyverno) registryUrl=(?<registryUrl>\\S+)\\n\\s*version: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Kyverno controller image digest and version.",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["/^core\\/platform\\/kyverno\\/helmrelease.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>ghcr.io/kyverno/\\S+)\\n\\s*tag: \"(?<currentValue>v\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "VolSync container image version and digest.",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["/^core\\/platform\\/backups\\/controller\\/helmrelease.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>quay.io/backube/volsync)\\n\\s*image: quay.io/backube/volsync:(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "restic rest-server image version tag and digest.",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["/^core\\/(platform\\/backups\\/rest-server|feature\\/apps-backup-server\\/rest-server-apps)\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>restic/rest-server)\\n\\s*image: restic/rest-server:(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "restic image version and digest.",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["/^core\\/(platform\\/backups\\/(etcd-snapshots|restic-check)|feature\\/offsite-backup-copy\\/restic-offsite)\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>restic/restic)\\n\\s*image: restic/restic:(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Grant reconciler python image tag and digest.",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["/^core\\/feature\\/app-hosting\\/grant-revoke\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>python)\\n\\s*image: python:(?<currentValue>\\d+\\.\\d+\\.\\d+-alpine\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "testapp image tag and digest, and any add-on that runs the same image.",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["/^core\\/platform\\/testapp\\/.+\\.yaml$/", "/^addons\\/[^/]+\\/.+\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>nginxinc/nginx-unprivileged)\\n\\s*image: nginxinc/nginx-unprivileged:(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9.]+)*)@(?<currentDigest>sha256:[a-f0-9]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "The mise release the devcontainers install: core's own (.devcontainer/devcontainer.json) and the instance one jarvis init writes (jarvis/kit/devcontainer/setup.sh).",
      "managerFilePatterns": ["/^\\.devcontainer\\/devcontainer\\.json$/", "/^jarvis\\/kit\\/devcontainer\\/setup\\.sh$/"],
      "matchStrings": ["(?:#|//) renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*\"?MISE_VERSION\"?(?:=|: \")(?<currentValue>v[^\\s\"]+)"]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "description": "Weekly PR refreshing the packages uv.lock and mise.lock hold beyond the direct pins (Python's transitive dependencies)."
  }
}
