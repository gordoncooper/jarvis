{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": false,
  "packageRules": [
    {
      "description": "Minor/patch: 3-day hold; flip automerge to true here after P2 exit (R33).",
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "3 days",
      "automerge": false
    },
    {
      "description": "Majors are never auto-merged (R33).",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "D5: k3s host binary is pinned in cluster-vars.yaml; changes only by PR.",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["k3s-io/k3s"],
      "enabled": false
    },
    {
      "description": "Group Flux Operator chart pin (platform/flux-operator/oci-repository.yaml).",
      "groupName": "flux-operator-chart",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["ghcr.io/controlplaneio-fluxcd/charts/flux-operator"]
    },
    {
      "description": "Flux distribution version is one pin in the role default and each env FluxInstance. Auto-merge stays off.",
      "groupName": "flux-distribution",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["fluxcd/flux2"],
      "automerge": false
    },
    {
      "description": "Helm host CLI version and sha256 are bumped together by PR.",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["helm/helm"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Datasource comments in Ansible defaults and Flux OCIRepository.",
      "managerFilePatterns": [
        "/^infra\\/ansible\\/roles\\/flux-operator\\/defaults\\/main\\.yml$/",
        "/^platform\\/flux-operator\\/oci-repository\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+?) depName=(?<depName>\\S+?)(?: versioning=(?<versioning>\\S+?))?\\s*\\nhelm_version: (?<currentValue>\\S+)",
        "# renovate: datasource=(?<datasource>\\S+?) depName=(?<depName>\\S+?)(?: versioning=(?<versioning>\\S+?))?\\s*\\n\\s*tag: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Flux distribution version in the Ansible role default and FluxInstance.",
      "managerFilePatterns": [
        "/^infra\\/ansible\\/roles\\/flux-operator\\/defaults\\/main\\.yml$/",
        "/^envs\\/[^/]+\\/flux\\/flux-instance\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+?) depName=(?<depName>\\S+?)(?: versioning=(?<versioning>\\S+?))?\\s*\\n\\s*(?:flux_distribution_version|version):\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ]
}
