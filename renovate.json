{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": false,
  "packageRules": [
    {
      "description": "k3s host binary is pinned in cluster-vars.yaml and changes only by PR, opened after approval in the dependency dashboard. A bump has to re-check platform/traefik and update the bundled chart and k3s versions in platform/traefik/CONTRACT.md.",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["k3s-io/k3s"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group Flux Operator chart pin (platform/flux-operator/oci-repository.yaml).",
      "groupName": "flux-operator-chart",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["ghcr.io/controlplaneio-fluxcd/charts/flux-operator"]
    },
    {
      "description": "Mover image stays on the VolSync chart minor. The backups contract depends on that minor's behaviour. Raise the cap in the same PR that bumps the chart to the next minor. One PR still updates every mover pin.",
      "groupName": "volsync-image",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["quay.io/backube/volsync"],
      "allowedVersions": "<0.18"
    },
    {
      "description": "The restic and rest-server images and the matching CLI pins in tools/versions.env move in one PR, because the rest-server isolation test requires them equal. Bump the CLI sha256 lines by hand in that PR.",
      "groupName": "restic",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["restic/restic", "restic/rest-server"]
    },
    {
      "description": "One PR updates every Kyverno image digest pin.",
      "groupName": "kyverno-image",
      "matchManagers": ["custom.regex"],
      "matchDepNames": [
        "ghcr.io/kyverno/kyverno",
        "ghcr.io/kyverno/kyvernopre",
        "ghcr.io/kyverno/background-controller"
      ]
    },
    {
      "description": "One PR updates every cert-manager image digest pin.",
      "groupName": "cert-manager-image",
      "matchManagers": ["custom.regex"],
      "matchDepNames": [
        "quay.io/jetstack/cert-manager-controller",
        "quay.io/jetstack/cert-manager-webhook",
        "quay.io/jetstack/cert-manager-cainjector",
        "quay.io/jetstack/cert-manager-startupapicheck",
        "quay.io/jetstack/cert-manager-acmesolver"
      ]
    },
    {
      "description": "Flux distribution version is one pin per env, in that env's FluxInstance. Auto-merge stays off. A bump merges only after the Flux Operator version that supports it is live, because the operator ships the manifests for each Flux version.",
      "groupName": "flux-distribution",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["fluxcd/flux2"],
      "automerge": false
    },
    {
      "description": "Helm host CLI version and sha256 are bumped together by PR, opened after approval in the dependency dashboard.",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["helm/helm"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "The kustomize repo tags other modules too (api/v0.x, cmd/config/v0.x) and older releases without a prefix. Only kustomize/v tags are kustomize releases.",
      "matchDepNames": ["kubernetes-sigs/kustomize"],
      "extractVersion": "^kustomize/v(?<version>.+)$"
    },
    {
      "description": "kubectl stays on the k3s minor. Raise this cap, and kubectl_version in tools/versions.env, in the same PR that moves k3s_version to the next minor. A test fails if they drift apart.",
      "matchDepNames": ["kubernetes/kubernetes"],
      "allowedVersions": "<1.37"
    },
    {
      "description": "Python dev dependencies in requirements-dev.txt update as one PR. Exact == pins stay exact.",
      "groupName": "python-dev",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["requirements-dev.txt"]
    },
    {
      "description": "ansible 14.x requires ansible-core 2.21.x. Raise this cap in the same PR as an ansible major bump. Patch updates inside 2.21 still flow.",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["requirements-dev.txt"],
      "matchPackageNames": ["ansible-core"],
      "allowedVersions": "<2.22"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pinned CLI versions in tools/versions.env. Renovate bumps the version only. The sha256 lines are bumped by hand in the same PR.",
      "managerFilePatterns": ["/^tools\\/versions\\.env$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+?) depName=(?<depName>\\S+?)\\s*\\n\\w+_version=(?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "k3s version in each env's cluster-vars.yaml. k3s_sha256 is bumped by hand in the same PR.",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "k3s-io/k3s",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$",
      "managerFilePatterns": ["/^envs\\/[^/]+\\/values\\/cluster-vars\\.yaml$/"],
      "matchStrings": ["k3s_version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+\\+k3s\\d+)"]
    },
    {
      "customType": "regex",
      "description": "Datasource comments in Ansible defaults and Flux OCIRepository.",
      "managerFilePatterns": [
        "/^infra\\/ansible\\/roles\\/flux-operator\\/defaults\\/main\\.yml$/",
        "/^platform\\/flux-operator\\/oci-repository\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+?) depName=(?<depName>\\S+?)(?: versioning=(?<versioning>\\S+?))?\\s*\\nhelm_version: (?<currentValue>\\S+)",
        "# renovate: datasource=(?<datasource>\\S+?) depName=(?<depName>\\S+?)(?: versioning=(?<versioning>\\S+?))?\\s*\\n\\s*tag: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Flux distribution version in each env FluxInstance.",
      "managerFilePatterns": ["/^envs\\/[^/]+\\/flux\\/flux-instance\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+?) depName=(?<depName>\\S+?)(?: versioning=(?<versioning>\\S+?))?\\s*\\n\\s*version:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "VolSync Helm chart pin.",
      "managerFilePatterns": ["/^platform\\/backups\\/controller\\/helmrelease.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>helm) depName=(?<depName>volsync) registryUrl=(?<registryUrl>\\S+)\\n\\s*version: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "cert-manager Helm chart pin.",
      "managerFilePatterns": ["/^platform\\/cert-manager\\/controller\\/helmrelease.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>helm) depName=(?<depName>cert-manager) registryUrl=(?<registryUrl>\\S+)\\n\\s*version: \"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "cert-manager component image tag and digest.",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["/^platform\\/cert-manager\\/controller\\/helmrelease.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>quay\\.io/jetstack/cert-manager-\\S+)\\n\\s*tag: \"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\"\\n\\s*digest: \"(?<currentDigest>sha256:[a-f0-9]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "k8s-gateway OCI chart pin.",
      "managerFilePatterns": ["/^platform\\/app-dns\\/helmrelease.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+?) depName=(?<depName>\\S+?)(?: versioning=(?<versioning>\\S+?))?\\s*\\n\\s*version: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "k8s_gateway image tag and digest.",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["/^platform\\/app-dns\\/helmrelease.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>codeberg\\.org/k8s-gateway/k8s_gateway)\\n\\s*tag: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Kyverno Helm chart pin.",
      "managerFilePatterns": ["/^platform\\/kyverno\\/helmrelease.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>helm) depName=(?<depName>kyverno) registryUrl=(?<registryUrl>\\S+)\\n\\s*version: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Kyverno controller image digest and version.",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["/^platform\\/kyverno\\/helmrelease.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>ghcr.io/kyverno/\\S+)\\n\\s*tag: \"(?<currentValue>v\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "VolSync container image version and digest.",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["/^platform\\/backups\\/controller\\/helmrelease.yaml$/"],
      "matchStrings": [
        "image: (?<depName>quay.io/backube/volsync):(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "restic rest-server image version tag and digest.",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["/^platform\\/(backups\\/rest-server|optional\\/apps-backup-server\\/rest-server-apps)\\.yaml$/"],
      "matchStrings": [
        "image: (?<depName>restic/rest-server):(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "restic image version and digest.",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["/^platform\\/(backups\\/(etcd-snapshots|restic-check)|optional\\/offsite-backup-copy\\/restic-offsite)\\.yaml$/"],
      "matchStrings": [
        "image: (?<depName>restic/restic):(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "testapp image tag and digest, and any add-on that runs the same image.",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["/^platform\\/testapp\\/.+\\.yaml$/", "/^services\\/[^/]+\\/.+\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>nginxinc/nginx-unprivileged)\\n\\s*image: nginxinc/nginx-unprivileged:(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9.]+)*)@(?<currentDigest>sha256:[a-f0-9]+)"
      ]
    }
  ]
}
