# Managed by Ansible (flux-operator role): the root source's read-only deploy key; not reconciled from Git.
apiVersion: v1
kind: Secret
metadata:
  name: {{ flux_deploy_key_secret_name }}
  namespace: {{ flux_system_namespace }}
  annotations:
    kustomize.toolkit.fluxcd.io/reconcile: disabled
type: Opaque
stringData:
  identity: |-
{{ lookup('community.sops.sops', flux_deploy_key_file, extract='["stringData"]["identity"]', age_keyfile=sops_age_key_file) | indent(4, true) }}
  known_hosts: {{ flux_known_hosts | to_json }}
