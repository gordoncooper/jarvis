{# Facts for the wipe-safety checks. Output is one JSON object. #}
{% set devices = node_disk_setup.ansible_facts.ansible_devices | default({}) %}
{% set mounts = node_disk_setup.ansible_facts.ansible_mounts | default([]) %}
{% set id_stat = node_disk_id_stat.stat %}
{% set exists = id_stat.exists | bool %}
{% set kernel = (id_stat.lnk_source | basename) if (exists and (id_stat.islnk | default(false))) else ((data_disk.id | basename) if exists else '') %}
{% set disk = devices[kernel] if kernel in devices else {} %}
{% set partitions = disk.partitions | default({}) %}
{% set part_names = partitions.keys() | list %}
{% set part_holders = partitions.values() | map(attribute='holders') | list | flatten %}
{% set holders = (disk.holders | default([])) + part_holders %}
{% set ours_names = [kernel] + part_names + holders %}
{% set ns_parts = namespace(names=[]) %}
{% for dev in devices.values() %}
{% for name in (dev.partitions | default({})).keys() %}
{% set ns_parts.names = ns_parts.names + [name] %}
{% endfor %}
{% endfor %}
{% set is_whole = kernel in devices %}
{% set is_partition = kernel in ns_parts.names %}
{% set stats = node_disk_mount_stats.results | default([]) %}
{% set ns_hit = namespace(points=[]) %}
{% for mount in mounts %}
{% set stat_item = stats[loop.index0] if (stats | length) > loop.index0 else {} %}
{% set ns_names = namespace(values=[]) %}
{% if mount.device is match('^/dev/') %}
{% set ns_names.values = ns_names.values + [mount.device | basename] %}
{% endif %}
{% if stat_item is mapping and not (stat_item.skipped | default(false)) and stat_item.stat is defined and (stat_item.stat.islnk | default(false)) %}
{% set ns_names.values = ns_names.values + [stat_item.stat.lnk_source | basename] %}
{% endif %}
{% if (ns_names.values | intersect(ours_names) | list | length) > 0 %}
{% set ns_hit.points = ns_hit.points + [mount.mount] %}
{% endif %}
{% endfor %}
{% set ns_root = namespace(saw=false, device='') %}
{% for line in (node_disk_proc_mounts.content | b64decode).split('\n') %}
{% set fields = line.split() %}
{% if (fields | length) > 1 and fields[1] == '/' %}
{% set ns_root.saw = true %}
{% set ns_root.device = fields[0] %}
{% endif %}
{% endfor %}
{% set root_mounts = mounts | selectattr('mount', 'equalto', '/') | list %}
{% set saw_root = ns_root.saw %}
{% set mounted_here = node_disk_mount in ns_hit.points %}
{% set mounted_elsewhere = ns_hit.points | reject('equalto', node_disk_mount) | list %}
{% set mountpoint_is_mount = (mounts | selectattr('mount', 'equalto', node_disk_mount) | list | length) > 0 %}
{% set mountpoint_foreign = mountpoint_is_mount and not mounted_here %}
{% set ns_lab = namespace(entries=[]) %}
{% for chunk in (node_disk_blkid.stdout | default('')).split('\n\n') %}
{% set row = namespace(dev='', label='') %}
{% for line in chunk.split('\n') %}
{% if line.startswith('DEVNAME=') %}
{% set row.dev = line[8:] %}
{% elif line.startswith('LABEL=') %}
{% set row.label = line[6:] %}
{% endif %}
{% endfor %}
{% if row.label %}
{% set ns_lab.entries = ns_lab.entries + [{'dev': row.dev, 'label': row.label}] %}
{% endif %}
{% endfor %}
{% set ns_where = namespace(on_self=false, elsewhere=false) %}
{% for entry in ns_lab.entries %}
{% if entry.label == node_disk_label %}
{% if (entry.dev | basename) in ours_names %}
{% set ns_where.on_self = true %}
{% else %}
{% set ns_where.elsewhere = true %}
{% endif %}
{% endif %}
{% endfor %}
{% set ours = ns_where.on_self and not ns_where.elsewhere %}
{% set mp = node_disk_mountpoint_stat.stat %}
{% set mp_exists = mp.exists | default(false) %}
{% set mp_isdir = mp.isdir | default(false) %}
{% set mp_entries = node_disk_mountpoint_entries.matched | default(0) | int %}
{% set mountpoint_nonempty = mp_exists and ((not mp_isdir) or ((not mountpoint_is_mount) and mp_entries > 0)) %}
{% set ns_nums = namespace(nums=[]) %}
{% for name in part_names %}
{% set number = name | regex_search('[0-9]+$') %}
{% if number %}
{% set ns_nums.nums = ns_nums.nums + [number | int] %}
{% endif %}
{% endfor %}
{% set partition_path = ('/dev/' ~ kernel ~ ('p1' if (kernel[-1] is match('[0-9]')) else '1')) if kernel else '' %}
{% set result = {
  'exists': exists,
  'kernel': kernel,
  'is_whole': is_whole,
  'is_partition': is_partition,
  'model': (disk.model | default('', true) | string | trim),
  'size': (disk.size | default('', true) | string | trim),
  'partitions': part_names,
  'partition_numbers': ns_nums.nums,
  'partition_path': partition_path,
  'saw_root': saw_root,
  'is_root': '/' in ns_hit.points,
  'root_mount_device': (ns_root.device if ns_root.device else (root_mounts[0].device if root_mounts else '')),
  'mounted_elsewhere': mounted_elsewhere,
  'mounted_here': mounted_here,
  'label_elsewhere': ns_where.elsewhere,
  'mountpoint_foreign': mountpoint_foreign,
  'mountpoint_nonempty': mountpoint_nonempty,
  'ours': ours,
} %}
{{ result | to_json }}
