{# Chrony, with NTS while chrony_nts is on. #}
# Managed by Ansible (base-os).
{% if chrony_nts | bool %}
# Outbound 123/udp and 4460/tcp must remain available for NTS; no node firewall changes here.
{% endif %}

keyfile /etc/chrony/chrony.keys
driftfile /var/lib/chrony/chrony.drift
ntsdumpdir /var/lib/chrony

{% for pool in ntp_pools %}
pool {{ pool }} iburst maxsources 4{% if chrony_nts | bool %} nts{% endif %}

{% endfor %}

leapsectz right/UTC
makestep 1.0 3
rtcsync

logdir /var/log/chrony
