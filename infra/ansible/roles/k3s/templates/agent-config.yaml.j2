# Managed by Ansible (k3s role): agent config.
server: {{ k3s_server_url }}
token: {{ k3s_token }}
node-name: {{ inventory_hostname }}
kubelet-arg:
  - "kube-reserved={{ jarvis_host_kube_reserved | default('') or k3s_kubelet_kube_reserved }}"
  - "system-reserved={{ jarvis_host_system_reserved | default('') or k3s_kubelet_system_reserved }}"
  - "eviction-hard={{ jarvis_host_eviction_hard | default('') or k3s_kubelet_eviction_hard }}"
{% if node_ip is defined and node_ip %}
node-ip: {{ node_ip }}
{% endif %}
