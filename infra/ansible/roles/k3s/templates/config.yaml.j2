# Managed by Ansible (k3s role): server config (framework §8 step 4; not the k3s install script).
cluster-init: true
secrets-encryption: true
cluster-cidr: {{ pod_cidr }}
service-cidr: {{ service_cidr }}
tls-san:
  - {{ inventory_hostname }}
default-local-storage-path: {{ local_path_data }}
etcd-snapshot-schedule-cron: "{{ k3s_etcd_snapshot_schedule_cron }}"
etcd-snapshot-retention: {{ k3s_etcd_snapshot_retention }}
etcd-snapshot-dir: {{ backup_path }}/etcd-snapshots
kubelet-arg:
  - "kube-reserved={{ k3s_kubelet_kube_reserved }}"
  - "system-reserved={{ k3s_kubelet_system_reserved }}"
  - "eviction-hard={{ k3s_kubelet_eviction_hard }}"
{% if nodes is defined and inventory_hostname in nodes and nodes[inventory_hostname].roles is defined %}
node-label:
{% for role in nodes[inventory_hostname].roles %}
  - "role.jarvis.lan/{{ role }}=true"
{% endfor %}
{% endif %}
