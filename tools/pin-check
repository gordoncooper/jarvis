#!/usr/bin/env python3
"""Refuse a run from a core checkout that is not the env's pinned core tag (core_git_ref).

make site, verify, drill and restore run this first. ALLOW_UNPINNED=1 (--allow-unpinned)
warns instead of refusing, for a deliberate run from a branch or a dirty checkout.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

from jarvis.lib.env import ENV_NAME, instance_root
from jarvis.lib.pin import ALLOW_FLAG, PinError, require_pin
from jarvis.schema.env import EXAMPLE_ENV

REPO_ROOT = Path(__file__).resolve().parents[1]


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--env", required=True)
    parser.add_argument(ALLOW_FLAG, dest="allow_unpinned", action="store_true")
    args = parser.parse_args(argv)
    if not ENV_NAME.fullmatch(args.env):
        print(f"pin-check: invalid env name {args.env!r}", file=sys.stderr)
        return 2
    env_dir = instance_root(REPO_ROOT) / "envs" / args.env
    # The example env is never deployed, and a missing env is the tool's own error to report.
    if args.env == EXAMPLE_ENV or not env_dir.is_dir():
        return 0
    try:
        warning = require_pin(REPO_ROOT, env_dir, allow_unpinned=args.allow_unpinned)
    except PinError as exc:
        print(f"pin-check: {exc}", file=sys.stderr)
        return 1
    if warning:
        print(f"pin-check: {warning}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
