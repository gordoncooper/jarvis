#!/usr/bin/env python3
"""Test-decrypt one secret for an env. Prints PASS or FAIL and nothing else.

The owner runs this under their own user, never a coding-agent user.
The key file must be unreadable by other users. Decrypted secret text is
not written to stdout, stderr, logs, or disk.
"""

from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
_SEGMENT = re.compile(r"^[a-z0-9-]+$")


def _one_secret(env: str) -> Path | None:
    if not _SEGMENT.fullmatch(env):
        return None
    secrets = (REPO_ROOT / "envs" / env / "secrets").resolve()
    if not secrets.is_dir():
        return None
    for path in sorted(secrets.glob("*.sops.yaml")):
        if path.is_file() and path.resolve().parent == secrets:
            return path
    return None


def check(env: str, key_file: Path) -> bool:
    """Return True only when key_file decrypts one of the env's secrets."""
    secret = _one_secret(env)
    sops = shutil.which("sops")
    if secret is None or sops is None or not key_file.is_file():
        return False
    child = os.environ.copy()
    child["SOPS_AGE_KEY_FILE"] = str(key_file)
    child.pop("SOPS_AGE_KEY", None)
    try:
        result = subprocess.run(
            [sops, "decrypt", str(secret)],
            cwd=REPO_ROOT,
            env=child,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except OSError:
        return False
    return result.returncode == 0 and bool(result.stdout.strip())


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--env", required=True, help="Env under envs/")
    parser.add_argument("--key-file", required=True, type=Path, help="Age private key file")
    args = parser.parse_args(argv)
    try:
        ok = check(args.env, args.key_file)
    except Exception:
        # A traceback can quote decrypted bytes. The owner only sees PASS or FAIL.
        ok = False
    print("PASS" if ok else "FAIL")
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
