#!/usr/bin/env python3
"""Test-decrypt one secret for an env. Prints PASS or FAIL and nothing else.

The owner runs this under their own user, never a coding-agent user.
The key file must be mode 0600 and owned by the current uid.
Decrypted secret text is not written to stdout, stderr, logs, or disk.
"""

from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import tempfile
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]

from jarvis.lib.env import instance_root  # noqa: E402

_SEGMENT = re.compile(r"^[a-z0-9-]+$")
_MODE_0600 = 0o600


def _one_secret(env: str) -> Path | None:
    if not _SEGMENT.fullmatch(env):
        return None
    secrets = (instance_root(REPO_ROOT) / "envs" / env / "secrets").resolve()
    if not secrets.is_dir():
        return None
    for path in sorted(secrets.glob("*.sops.yaml")):
        if path.is_file() and path.resolve().parent == secrets:
            return path
    return None


def _decrypt_env(key_file: Path, empty: str) -> dict[str, str]:
    """Pass sops this key file and no other identity.

    The process environment is not copied. HOME and XDG_CONFIG_HOME point at
    an empty directory, so the default per-user key file and the default SSH
    key files are absent.
    """
    return {
        "PATH": os.environ.get("PATH", ""),
        "HOME": empty,
        "XDG_CONFIG_HOME": empty,
        "TMPDIR": empty,
        "SOPS_AGE_KEY_FILE": str(key_file),
    }


def check(env: str, key_file: Path) -> bool:
    """Return True only when key_file decrypts one of the env's secrets."""
    try:
        info = key_file.stat()
    except OSError:
        return False
    if not key_file.is_file() or (info.st_mode & 0o777) != _MODE_0600 or info.st_uid != os.getuid():
        return False
    secret = _one_secret(env)
    sops = shutil.which("sops")
    if secret is None or sops is None:
        return False
    try:
        with tempfile.TemporaryDirectory(prefix="jarvis-age-key-check-") as empty:
            result = subprocess.run(
                [sops, "decrypt", str(secret)],
                cwd=instance_root(REPO_ROOT),
                env=_decrypt_env(key_file, empty),
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                check=False,
            )
    except OSError:
        return False
    return result.returncode == 0 and bool(result.stdout.strip())


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--env", required=True, help="Env under envs/")
    parser.add_argument("--key-file", required=True, type=Path, help="Age private key file")
    args = parser.parse_args(argv)
    try:
        ok = check(args.env, args.key_file)
    except Exception:
        # A traceback can quote decrypted bytes. The owner only sees PASS or FAIL.
        ok = False
    print("PASS" if ok else "FAIL")
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
