#!/usr/bin/env python3
"""Restore PVC data with a one-shot VolSync ReplicationDestination.

Pauses that PVC's ReplicationSource first (annotation backup: paused),
after the workloads that mount it are stopped.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import time
import zlib
from collections.abc import Callable, Sequence
from datetime import datetime, timedelta, timezone
from pathlib import Path
from subprocess import CompletedProcess

import yaml

REPO_ROOT = Path(__file__).resolve().parents[1]
PAUSE_BUDGET_SECONDS = 120
RESTORE_BUDGET_SECONDS = 30 * 60
_POLL_SECONDS = 5.0
# VolSync 0.17 job prefix. Longer than 63 characters, the rest is crc32 of the owner name.
_JOB_NAME_MAX = 63
_SRC_JOB_PREFIX = "volsync-src-"
_BIND_PREFIX = "restore-bind-"
_NO_SNAPSHOT = "No eligible snapshots found"
# VolSync's restic log filter keeps a line that starts with "restoring" after a real restore.
_RESTORING = re.compile(r"(?im)^\s*restoring\b")
_FLUX_NAME = "kustomize.toolkit.fluxcd.io/name"
_FLUX_NS = "kustomize.toolkit.fluxcd.io/namespace"
HOLD_NAMESPACE = "kube-system"
HOLD_NAME = "backup-rebuild-hold"
# Same digest as CronJob etcd-snapshots. The binder only runs exit 0.
_BIND_IMAGE = "restic/restic@sha256:136600b6ff6843d61d355f7f71f460a166429f35de6fd11b568fece3c9a4d510"
_DONE_PHASES = {"Succeeded", "Failed"}

Kubectl = Callable[..., CompletedProcess[str]]
Mono = Callable[[], float]
Sleeper = Callable[[float], None]


class Fail(Exception):
    def __init__(self, message: str) -> None:
        super().__init__(message)
        self.message = message


class NoSnapshot(Exception):
    """Mover exited 0 and printed that nothing matched restoreAsOf."""

    def __init__(self, namespace: str, pvc: str) -> None:
        super().__init__(f"{namespace}/{pvc}: no eligible snapshots")
        self.namespace = namespace
        self.pvc = pvc


class _Quiesce:
    def __init__(self) -> None:
        self.deployments: dict[str, int] = {}
        self.statefulsets: dict[str, int] = {}
        self.kustomizations: list[tuple[str, str]] = []
        self.paused = False
        self.destination = False


def _line(text: str) -> None:
    print(text, flush=True)


def _tool_env() -> dict[str, str]:
    env = os.environ.copy()
    prefix = os.pathsep.join(
        (
            str(REPO_ROOT / ".venv" / "bin"),
            str(Path.home() / ".local" / "bin"),
        )
    )
    env["PATH"] = prefix + os.pathsep + env.get("PATH", "")
    return env


def _kubectl(args: Sequence[str], input: str | None = None) -> CompletedProcess[str]:
    try:
        return subprocess.run(
            ["kubectl", *args],
            input=input,
            env=_tool_env(),
            capture_output=True,
            text=True,
            check=False,
        )
    except FileNotFoundError:
        _line("run make deps")
        raise SystemExit(1) from None


def _reason(proc: CompletedProcess[str]) -> str:
    text = (proc.stderr or proc.stdout or "kubectl failed").strip()
    return text.splitlines()[0] if text else "kubectl failed"


def _ok(proc: CompletedProcess[str], what: str) -> None:
    if proc.returncode != 0:
        raise Fail(f"{what}: {_reason(proc)}")


def _load(proc: CompletedProcess[str], what: str) -> dict:
    _ok(proc, what)
    try:
        body = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise Fail(f"{what}: invalid kubectl JSON") from exc
    if not isinstance(body, dict):
        raise Fail(f"{what}: invalid kubectl JSON")
    return body


def _not_found(proc: CompletedProcess[str]) -> bool:
    if proc.returncode == 0:
        return False
    text = f"{proc.stderr}\n{proc.stdout}"
    return "NotFound" in text or "not found" in text.lower()


def _load_if_present(proc: CompletedProcess[str], what: str) -> dict | None:
    if _not_found(proc):
        return None
    return _load(proc, what)


def job_name(owner: str, *, prefix: str = _SRC_JOB_PREFIX) -> str:
    plain = prefix + owner
    if len(plain) <= _JOB_NAME_MAX:
        return plain
    digest = zlib.crc32(owner.encode()) & 0xFFFFFFFF
    return f"{prefix}{digest:08x}"


def restore_as_of(created: str) -> str:
    stamp = datetime.fromisoformat(created.replace("Z", "+00:00"))
    earlier = stamp - timedelta(seconds=1)
    return earlier.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def normalize_as_of(value: str) -> str:
    try:
        stamp = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as exc:
        raise Fail(f"AS_OF must be RFC3339: {value}") from exc
    if stamp.tzinfo is None:
        raise Fail(f"AS_OF must include a timezone: {value}")
    return stamp.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def eligible(item: dict) -> bool:
    meta = item.get("metadata") or {}
    annotations = meta.get("annotations") or {}
    labels = meta.get("labels") or {}
    if annotations.get("backup") == "none":
        return False
    if labels.get("app.kubernetes.io/created-by") == "volsync":
        return False
    return True


def destination_body(namespace: str, pvc: str, as_of: str, manual: str) -> dict:
    return {
        "apiVersion": "volsync.backube/v1alpha1",
        "kind": "ReplicationDestination",
        "metadata": {"name": f"restore-{pvc}", "namespace": namespace},
        "spec": {
            "trigger": {"manual": manual},
            "restic": {
                "destinationPVC": pvc,
                "repository": f"restic-{pvc}",
                "copyMethod": "Direct",
                "enableFileDeletion": True,
                "restoreAsOf": as_of,
            },
        },
    }


def _repo_id(namespace: str, pvc: str) -> str:
    return f"ns-{namespace}/pvc-{pvc}"


def parse_repo(repo: str) -> tuple[str, str] | None:
    if "/" not in repo:
        return None
    left, right = repo.split("/", 1)
    if not left.startswith("ns-") or not right.startswith("pvc-"):
        return None
    return left.removeprefix("ns-"), right.removeprefix("pvc-")


def _wait(pred: Callable[[], bool], *, budget_s: float, monotonic: Mono, sleep: Sleeper) -> bool:
    deadline = monotonic() + budget_s
    while True:
        if pred():
            return True
        if monotonic() >= deadline:
            return False
        sleep(min(_POLL_SECONDS, max(0.0, deadline - monotonic())))


def _pvc_body(kubectl: Kubectl, namespace: str, pvc: str) -> dict:
    return _load(
        kubectl(["get", "pvc", pvc, "-n", namespace, "-o", "json"]),
        f"get pvc {namespace}/{pvc}",
    )


def _replication_source(kubectl: Kubectl, namespace: str, pvc: str) -> dict | None:
    return _load_if_present(
        kubectl(["get", "replicationsource", pvc, "-n", namespace, "-o", "json"]),
        f"get replicationsource {namespace}/{pvc}",
    )


def _source_paused(kubectl: Kubectl, namespace: str, pvc: str) -> bool:
    body = _replication_source(kubectl, namespace, pvc)
    if body is None:
        return False
    return (body.get("spec") or {}).get("paused") is True


def _source_unpaused(kubectl: Kubectl, namespace: str, pvc: str) -> bool:
    """Missing is not ready. A missing source is not an unpaused source."""
    body = _replication_source(kubectl, namespace, pvc)
    if body is None:
        return False
    return (body.get("spec") or {}).get("paused") is not True


def _job_parallelism_zero(kubectl: Kubectl, namespace: str, name: str) -> bool:
    body = _load_if_present(
        kubectl(["get", "job", name, "-n", namespace, "-o", "json"]),
        f"get job {namespace}/{name}",
    )
    if body is None:
        return True
    parallelism = (body.get("spec") or {}).get("parallelism", 1)
    return parallelism == 0


def _pod_mounts(pod: dict, pvc: str) -> bool:
    for volume in (pod.get("spec") or {}).get("volumes") or []:
        claim = (volume.get("persistentVolumeClaim") or {}).get("claimName")
        if claim == pvc:
            return True
    return False


def _pod_blocks_volume(pod: dict) -> bool:
    """Running, pending, or still terminating. status.active ignores terminating pods."""
    meta = pod.get("metadata") or {}
    if meta.get("deletionTimestamp"):
        return True
    phase = (pod.get("status") or {}).get("phase") or "Pending"
    return phase not in _DONE_PHASES


def volume_holders(kubectl: Kubectl, namespace: str, pvc: str) -> list[str]:
    body = _load(
        kubectl(["get", "pods", "-n", namespace, "-o", "json"]),
        f"list pods {namespace}",
    )
    names: list[str] = []
    for pod in body.get("items") or []:
        meta = pod.get("metadata") or {}
        name = str(meta.get("name") or "")
        if name.startswith(_BIND_PREFIX):
            continue
        if _pod_mounts(pod, pvc) and _pod_blocks_volume(pod):
            names.append(name)
    return names


def _secret_ready(kubectl: Kubectl, namespace: str, pvc: str) -> bool:
    proc = kubectl(["get", "secret", f"restic-{pvc}", "-n", namespace, "-o", "name"])
    return proc.returncode == 0


def _paused(kubectl: Kubectl, namespace: str, pvc: str) -> bool:
    return (
        _source_paused(kubectl, namespace, pvc)
        and _job_parallelism_zero(kubectl, namespace, job_name(pvc))
        and not volume_holders(kubectl, namespace, pvc)
        and _secret_ready(kubectl, namespace, pvc)
    )


def _restored(kubectl: Kubectl, namespace: str, name: str, manual: str) -> bool:
    body = _load_if_present(
        kubectl(["get", "replicationdestination", name, "-n", namespace, "-o", "json"]),
        f"get replicationdestination {namespace}/{name}",
    )
    if body is None:
        return False
    return (body.get("status") or {}).get("lastManualSync") == manual


def _flux_ref(obj: dict) -> tuple[str, str] | None:
    labels = (obj.get("metadata") or {}).get("labels") or {}
    name = labels.get(_FLUX_NAME)
    namespace = labels.get(_FLUX_NS)
    if name and namespace:
        return namespace, name
    return None


def _claim_in_pod_spec(spec: dict, pvc: str) -> bool:
    return _pod_mounts({"spec": spec}, pvc)


def _sts_owns(sts: dict, pvc: str) -> bool:
    template = ((sts.get("spec") or {}).get("template") or {}).get("spec") or {}
    if _claim_in_pod_spec(template, pvc):
        return True
    sts_name = (sts.get("metadata") or {}).get("name") or ""
    for claim in (sts.get("spec") or {}).get("volumeClaimTemplates") or []:
        template_name = (claim.get("metadata") or {}).get("name") or ""
        prefix = f"{template_name}-{sts_name}-"
        ordinal = pvc[len(prefix) :] if pvc.startswith(prefix) else ""
        if ordinal.isdigit():
            return True
    return False


def _replicas(spec: dict) -> int:
    replicas = spec.get("replicas")
    if replicas is None:
        return 1
    return replicas


def _items(kubectl: Kubectl, kind: str, namespace: str) -> list[dict]:
    body = _load(kubectl(["get", kind, "-n", namespace, "-o", "json"]), f"list {kind}")
    return list(body.get("items") or [])


def _suspend(kubectl: Kubectl, owners: list[dict], state: _Quiesce) -> None:
    refs: list[tuple[str, str]] = []
    for obj in owners:
        ref = _flux_ref(obj)
        if ref is not None and ref not in refs:
            refs.append(ref)
    known = set(state.kustomizations)
    for ref_ns, ref_name in refs:
        if (ref_ns, ref_name) in known:
            continue
        body = _load_if_present(
            kubectl(["get", "kustomization", ref_name, "-n", ref_ns, "-o", "json"]),
            f"get kustomization {ref_ns}/{ref_name}",
        )
        if body is None or (body.get("spec") or {}).get("suspend") is True:
            continue
        _ok(
            kubectl(
                [
                    "patch",
                    "kustomization",
                    ref_name,
                    "-n",
                    ref_ns,
                    "--type",
                    "merge",
                    "-p",
                    json.dumps({"spec": {"suspend": True}}),
                ]
            ),
            f"suspend kustomization {ref_ns}/{ref_name}",
        )
        state.kustomizations.append((ref_ns, ref_name))


def _scale_kind(
    kubectl: Kubectl,
    namespace: str,
    kind: str,
    stored: dict[str, int],
    owns: Callable[[dict], bool],
) -> None:
    for obj in _items(kubectl, kind, namespace):
        name = (obj.get("metadata") or {}).get("name")
        if not name or not owns(obj):
            continue
        if name not in stored:
            current = _replicas(obj.get("spec") or {})
            if current == 0:
                continue
            stored[name] = current
        _ok(
            kubectl(["scale", kind, name, "-n", namespace, "--replicas=0"]),
            f"scale {kind} {namespace}/{name}",
        )


def _quiesce(kubectl: Kubectl, namespace: str, pvc: str, pvc_body: dict, state: _Quiesce) -> None:
    deployments = _items(kubectl, "deployment", namespace)
    statefulsets = _items(kubectl, "statefulset", namespace)
    owners = [pvc_body, *deployments, *statefulsets]
    _suspend(kubectl, owners, state)
    _scale_kind(
        kubectl,
        namespace,
        "deployment",
        state.deployments,
        lambda obj: _claim_in_pod_spec(
            ((obj.get("spec") or {}).get("template") or {}).get("spec") or {}, pvc
        ),
    )
    _scale_kind(
        kubectl,
        namespace,
        "statefulset",
        state.statefulsets,
        lambda obj: _sts_owns(obj, pvc),
    )


def _unquiesce(kubectl: Kubectl, namespace: str, state: _Quiesce) -> None:
    for name, replicas in state.deployments.items():
        _ok(
            kubectl(["scale", "deployment", name, "-n", namespace, f"--replicas={replicas}"]),
            f"scale deployment {namespace}/{name}",
        )
    for name, replicas in state.statefulsets.items():
        _ok(
            kubectl(["scale", "statefulset", name, "-n", namespace, f"--replicas={replicas}"]),
            f"scale statefulset {namespace}/{name}",
        )
    for ref_ns, ref_name in state.kustomizations:
        _ok(
            kubectl(
                [
                    "patch",
                    "kustomization",
                    ref_name,
                    "-n",
                    ref_ns,
                    "--type",
                    "merge",
                    "-p",
                    json.dumps({"spec": {"suspend": False}}),
                ]
            ),
            f"resume kustomization {ref_ns}/{ref_name}",
        )
    state.deployments.clear()
    state.statefulsets.clear()
    state.kustomizations.clear()


def _print_left(namespace: str, pvc: str, state: _Quiesce) -> None:
    if state.paused:
        _line(f"kubectl annotate pvc {pvc} -n {namespace} backup-")
    for name, replicas in state.deployments.items():
        _line(f"kubectl scale deployment {name} -n {namespace} --replicas={replicas}")
    for name, replicas in state.statefulsets.items():
        _line(f"kubectl scale statefulset {name} -n {namespace} --replicas={replicas}")
    for ref_ns, ref_name in state.kustomizations:
        _line(
            f"kubectl patch kustomization {ref_name} -n {ref_ns}"
            " --type merge -p '{\"spec\":{\"suspend\":false}}'"
        )
    if state.destination:
        _line(
            f"kubectl delete replicationdestination restore-{pvc} -n {namespace} --wait=true"
        )


def _binder_name(pvc: str) -> str:
    return job_name(pvc, prefix=_BIND_PREFIX)


def _binder_body(namespace: str, pvc: str) -> dict:
    return {
        "apiVersion": "v1",
        "kind": "Pod",
        "metadata": {"name": _binder_name(pvc), "namespace": namespace},
        "spec": {
            "restartPolicy": "Never",
            "containers": [
                {
                    "name": "bind",
                    "image": _BIND_IMAGE,
                    "command": ["sh", "-c", "exit 0"],
                    "volumeMounts": [{"name": "data", "mountPath": "/data"}],
                }
            ],
            "volumes": [
                {"name": "data", "persistentVolumeClaim": {"claimName": pvc}},
            ],
        },
    }


def _binder_gone(kubectl: Kubectl, namespace: str, pvc: str) -> bool:
    body = _load(
        kubectl(["get", "pods", "-n", namespace, "-o", "json"]),
        f"list pods {namespace}",
    )
    name = _binder_name(pvc)
    for pod in body.get("items") or []:
        if (pod.get("metadata") or {}).get("name") == name:
            return False
    return True


def _bind(
    kubectl: Kubectl,
    namespace: str,
    pvc: str,
    *,
    monotonic: Mono,
    sleep: Sleeper,
    pause_budget_s: float,
) -> None:
    body = yaml.safe_dump(_binder_body(namespace, pvc), sort_keys=False)
    _ok(kubectl(["apply", "-f", "-"], input=body), f"bind {namespace}/{pvc}")

    def bound() -> bool:
        current = _load(
            kubectl(["get", "pvc", pvc, "-n", namespace, "-o", "json"]),
            f"get pvc {namespace}/{pvc}",
        )
        return bool((current.get("spec") or {}).get("volumeName"))

    if not _wait(bound, budget_s=pause_budget_s, monotonic=monotonic, sleep=sleep):
        raise Fail(f"{namespace}/{pvc}: PVC did not bind")
    _ok(
        kubectl(
            [
                "delete",
                "pod",
                _binder_name(pvc),
                "-n",
                namespace,
                "--wait=false",
                "--ignore-not-found=true",
            ]
        ),
        f"delete binder {namespace}/{pvc}",
    )
    if not _wait(
        lambda: _binder_gone(kubectl, namespace, pvc),
        budget_s=pause_budget_s,
        monotonic=monotonic,
        sleep=sleep,
    ):
        raise Fail(f"{namespace}/{pvc}: binder pod did not exit")


def _hold_repos(kubectl: Kubectl) -> list[str] | None:
    proc = kubectl(["get", "configmap", HOLD_NAME, "-n", HOLD_NAMESPACE, "-o", "json"])
    body = _load_if_present(proc, "read rebuild hold")
    if body is None:
        return None
    text = ((body.get("data") or {}).get("repos")) or ""
    return [line.strip() for line in text.splitlines() if line.strip()]


def _resume(kubectl: Kubectl, namespace: str, pvc: str) -> None:
    _ok(
        kubectl(["annotate", "pvc", pvc, "-n", namespace, "backup-"]),
        f"resume {namespace}/{pvc}",
    )


def _delete_destination(kubectl: Kubectl, namespace: str, pvc: str) -> None:
    _ok(
        kubectl(
            [
                "delete",
                "replicationdestination",
                f"restore-{pvc}",
                "-n",
                namespace,
                "--wait=true",
                "--ignore-not-found=true",
            ]
        ),
        f"delete {namespace}/restore-{pvc}",
    )


def _mover_logs(kubectl: Kubectl, namespace: str, pvc: str) -> str:
    # VolSync 0.17 writes the filtered mover log here, then deletes the Job.
    name = f"restore-{pvc}"
    body = _load(
        kubectl(["get", "replicationdestination", name, "-n", namespace, "-o", "json"]),
        f"get {namespace}/{name}",
    )
    latest = (body.get("status") or {}).get("latestMoverStatus") or {}
    return latest.get("logs") or ""


def _restore_one(
    kubectl: Kubectl,
    namespace: str,
    pvc: str,
    created: str,
    *,
    as_of: str | None,
    resume: bool,
    skip_missing: bool,
    monotonic: Mono,
    sleep: Sleeper,
    now: Callable[[], float],
    pause_budget_s: float,
    restore_budget_s: float,
) -> None:
    state = _Quiesce()
    try:
        current = _pvc_body(kubectl, namespace, pvc)
        _quiesce(kubectl, namespace, pvc, current, state)
        _line(f"pause {namespace}/{pvc}")
        _ok(
            kubectl(["annotate", "pvc", pvc, "-n", namespace, "backup=paused", "--overwrite"]),
            f"annotate {namespace}/{pvc}",
        )
        state.paused = True
        volume = (current.get("spec") or {}).get("volumeName") or ""
        if not volume:
            _bind(
                kubectl,
                namespace,
                pvc,
                monotonic=monotonic,
                sleep=sleep,
                pause_budget_s=pause_budget_s,
            )
        if not _wait(
            lambda: _paused(kubectl, namespace, pvc),
            budget_s=pause_budget_s,
            monotonic=monotonic,
            sleep=sleep,
        ):
            holders = volume_holders(kubectl, namespace, pvc)
            if holders:
                raise Fail(f"{namespace}/{pvc}: pods still mounted ({', '.join(holders)})")
            raise Fail(f"{namespace}/{pvc}: ReplicationSource did not pause")
        chosen_as_of = as_of if as_of is not None else restore_as_of(created)
        manual = f"restore-{int(now())}"
        name = f"restore-{pvc}"
        _line(f"restore {namespace}/{pvc} as-of {chosen_as_of}")
        body = yaml.safe_dump(
            destination_body(namespace, pvc, chosen_as_of, manual),
            sort_keys=False,
        )
        _ok(kubectl(["apply", "-f", "-"], input=body), f"apply {namespace}/{name}")
        state.destination = True
        if not _wait(
            lambda: _restored(kubectl, namespace, name, manual),
            budget_s=restore_budget_s,
            monotonic=monotonic,
            sleep=sleep,
        ):
            raise Fail(f"{namespace}/{pvc}: ReplicationDestination did not finish")
        logs = _mover_logs(kubectl, namespace, pvc)
        if _NO_SNAPSHOT not in logs and _RESTORING.search(logs) is None:
            # An empty log is what VolSync stores when it cannot read the mover pod.
            raise Fail(f"{namespace}/{pvc}: mover log has no restore result")
        if _NO_SNAPSHOT in logs:
            # The mover exits 0 and still sets lastManualSync. That is not a restore.
            if not skip_missing:
                raise Fail(f"{namespace}/{pvc}: no eligible snapshots")
            _delete_destination(kubectl, namespace, pvc)
            state.destination = False
            if resume:
                _resume(kubectl, namespace, pvc)
                state.paused = False
            _unquiesce(kubectl, namespace, state)
            raise NoSnapshot(namespace, pvc)
        _delete_destination(kubectl, namespace, pvc)
        state.destination = False
        if not _wait(
            lambda: not volume_holders(kubectl, namespace, pvc),
            budget_s=pause_budget_s,
            monotonic=monotonic,
            sleep=sleep,
        ):
            raise Fail(f"{namespace}/{pvc}: mover pod still terminating")
        if resume:
            _resume(kubectl, namespace, pvc)
            state.paused = False
        _unquiesce(kubectl, namespace, state)
        _line(f"PASS restore {namespace}/{pvc}")
    except NoSnapshot:
        raise
    except Fail:
        kubectl(
            [
                "delete",
                "pod",
                _binder_name(pvc),
                "-n",
                namespace,
                "--wait=false",
                "--ignore-not-found=true",
            ]
        )
        _print_left(namespace, pvc, state)
        raise


def _select(kubectl: Kubectl, app: str | None) -> tuple[list[tuple[str, str, str]], set[tuple[str, str]]]:
    args = ["get", "pvc", "-o", "json"]
    if app is None:
        args[2:2] = ["-A"]
    else:
        args[2:2] = ["-n", app]
    body = _load(kubectl(args), "list pvc")
    chosen: list[tuple[str, str, str]] = []
    present: set[tuple[str, str]] = set()
    for item in body.get("items") or []:
        meta = item.get("metadata") or {}
        namespace = meta.get("namespace")
        name = meta.get("name")
        if not namespace or not name:
            continue
        present.add((namespace, name))
        if not eligible(item):
            continue
        created = meta.get("creationTimestamp")
        if not created:
            raise Fail(f"{namespace}/{name}: no creationTimestamp")
        chosen.append((namespace, name, created))
    chosen.sort()
    return chosen, present


def _retired(values: Sequence[str] | None) -> set[str]:
    found: set[str] = set()
    for value in values or []:
        for part in value.replace(",", " ").split():
            found.add(part)
    return found


def _lift_hold(
    kubectl: Kubectl,
    hold: list[str],
    present: set[tuple[str, str]],
    done: list[tuple[str, str]],
    retired: set[str],
    *,
    monotonic: Mono,
    sleep: Sleeper,
    pause_budget_s: float,
) -> None:
    missing = [
        repo for repo in hold if parse_repo(repo) not in present and repo not in retired
    ]
    if missing:
        for repo in missing:
            _line(f"HOLD kept: no PVC for {repo}")
        _line("HOLD kept: backup=paused remains")
        raise Fail("rebuild hold kept")
    for repo in hold:
        if repo in retired and parse_repo(repo) not in present:
            _line(f"HOLD retired {repo}")
    # Deleting the hold does not re-run generate. Remove backup: paused after it is gone.
    _ok(
        kubectl(
            [
                "delete",
                "configmap",
                HOLD_NAME,
                "-n",
                HOLD_NAMESPACE,
                "--wait=true",
                "--ignore-not-found=true",
            ]
        ),
        "delete rebuild hold",
    )
    _line("HOLD lifted")
    for namespace, pvc in done:
        _resume(kubectl, namespace, pvc)
        if not _wait(
            lambda namespace=namespace, pvc=pvc: _source_unpaused(kubectl, namespace, pvc),
            budget_s=pause_budget_s,
            monotonic=monotonic,
            sleep=sleep,
        ):
            raise Fail(f"{namespace}/{pvc}: source stayed paused after the hold was lifted")


def run(
    kubectl: Kubectl,
    *,
    app: str | None,
    all_pvcs: bool,
    as_of: str | None = None,
    retire: Sequence[str] | None = None,
    monotonic: Mono | None = None,
    sleep: Sleeper | None = None,
    now: Callable[[], float] | None = None,
    pause_budget_s: float = PAUSE_BUDGET_SECONDS,
    restore_budget_s: float = RESTORE_BUDGET_SECONDS,
) -> int:
    if all_pvcs == (app is not None):
        _line("pass APP=<namespace> or --all")
        return 1
    clock = monotonic or time.monotonic
    pause = sleep or time.sleep
    stamp = now or time.time
    override = as_of if as_of is not None else os.environ.get("AS_OF") or None
    if override == "":
        override = None
    try:
        if override is not None:
            override = normalize_as_of(override)
        chosen, present = _select(kubectl, None if all_pvcs else app)
        hold = _hold_repos(kubectl)
        retired = _retired(retire)
        if not chosen and (hold is None or not all_pvcs):
            raise Fail("no PVC to restore")
        done: list[tuple[str, str]] = []
        for namespace, pvc, created in chosen:
            try:
                _restore_one(
                    kubectl,
                    namespace,
                    pvc,
                    created,
                    as_of=override,
                    resume=hold is None,
                    skip_missing=all_pvcs,
                    monotonic=clock,
                    sleep=pause,
                    now=stamp,
                    pause_budget_s=pause_budget_s,
                    restore_budget_s=restore_budget_s,
                )
            except NoSnapshot:
                _line(f"SKIP no snapshot {namespace}/{pvc}")
            done.append((namespace, pvc))
        if hold is not None and not all_pvcs:
            _line("HOLD still set; backup=paused remains until make restore-all lifts it")
        if all_pvcs and hold is not None:
            _lift_hold(
                kubectl,
                hold,
                present,
                done,
                retired,
                monotonic=clock,
                sleep=pause,
                pause_budget_s=pause_budget_s,
            )
    except Fail as exc:
        _line(f"FAIL {exc.message}")
        return 1
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--app", help="Namespace whose PVCs to restore")
    parser.add_argument("--all", action="store_true", help="Restore every enrolled PVC")
    parser.add_argument(
        "--as-of",
        help="RFC3339 restoreAsOf for every selected PVC (default: creation time minus 1s)",
    )
    parser.add_argument(
        "--retire",
        action="append",
        default=[],
        help="Hold repo id with no PVC that the owner retired (repeat, or comma-separate)",
    )
    args = parser.parse_args(argv)
    app = args.app or None
    return run(_kubectl, app=app, all_pvcs=args.all, as_of=args.as_of, retire=args.retire)


if __name__ == "__main__":
    sys.exit(main())
