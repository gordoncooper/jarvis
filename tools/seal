#!/usr/bin/env python3
"""Encrypt a plaintext Kubernetes Secret manifest into envs/<env>/secrets/ (R25)."""

from __future__ import annotations

import argparse
import importlib.util
import subprocess
import sys
import tempfile
from pathlib import Path

import yaml

REPO_ROOT = Path(__file__).resolve().parents[1]
DEFAULT_ENV = "env-01"


def _repo_root() -> Path:
    return REPO_ROOT


def _resolve_sops() -> str:
    # Reuse bootstrap-secrets tool discovery when available.
    bootstrap = _repo_root() / "tools" / "bootstrap-secrets"
    if bootstrap.is_file():
        import importlib.machinery

        loader = importlib.machinery.SourceFileLoader("bootstrap_secrets", str(bootstrap))
        spec = importlib.util.spec_from_loader("bootstrap_secrets", loader)
        assert spec is not None
        mod = importlib.util.module_from_spec(spec)
        sys.modules[spec.name] = mod
        loader.exec_module(mod)
        return mod._resolve_tools()[0]
    for candidate in (
        Path.home() / ".local" / "bin" / "sops",
        Path("/usr/local/bin/sops"),
        Path("/usr/bin/sops"),
    ):
        if candidate.is_file():
            return str(candidate)
    raise SystemExit("sops not found; run make bootstrap-secrets once to install ~/.local/bin/sops")


def seal(
    env: str,
    name: str,
    plaintext: str,
    *,
    sops_bin: str | None = None,
    force: bool = False,
) -> Path:
    """Write name.sops.yaml under envs/<env>/secrets/. Fails if present unless force."""
    doc = yaml.safe_load(plaintext)
    if not isinstance(doc, dict) or doc.get("kind") != "Secret":
        raise SystemExit("stdin must be a Kubernetes Secret manifest (kind: Secret)")
    meta = doc.get("metadata") or {}
    if meta.get("name") and meta.get("name") != name:
        raise SystemExit("metadata.name must match --name")
    meta["name"] = name
    doc["metadata"] = meta

    out = _repo_root() / "envs" / env / "secrets" / f"{name}.sops.yaml"
    if out.exists() and not force:
        raise SystemExit(f"{out} exists; pass --force to replace")

    sops = sops_bin or _resolve_sops()
    out.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", delete=False, dir=out.parent) as tmp:
        yaml.safe_dump(doc, tmp, sort_keys=False)
        tmp_path = Path(tmp.name)
    try:
        tmp_path.replace(out)
        subprocess.check_call([sops, "encrypt", "--in-place", str(out)], cwd=_repo_root())
    finally:
        if tmp_path.exists():
            tmp_path.unlink(missing_ok=True)
    return out


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--env", default=DEFAULT_ENV, help=f"Env under envs/ (default: {DEFAULT_ENV})")
    parser.add_argument("--name", required=True, help="Secret name (<component>-<purpose>)")
    parser.add_argument(
        "--force",
        action="store_true",
        help="Replace an existing file (bootstrap-secrets never overwrites; seal may for rotation)",
    )
    parser.add_argument("file", nargs="?", help="Plaintext Secret YAML (default: stdin)")
    args = parser.parse_args(argv)

    if args.file:
        plaintext = Path(args.file).read_text(encoding="utf-8")
    else:
        plaintext = sys.stdin.read()
    if not plaintext.strip():
        raise SystemExit("empty input")

    path = seal(args.env, args.name, plaintext, force=args.force)
    print(path.relative_to(_repo_root()))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
