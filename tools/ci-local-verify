#!/usr/bin/env bash
# Pre-push verification: checks, renovate validator, full pytest (including containers).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

export PATH="${HOME}/.local/bin:${PATH}"

renovate-config-validator
bash tools/run-checks

if ! docker info >/dev/null 2>&1; then
  echo "docker: permission denied (agent must be in the docker group)" >&2
  exit 1
fi

"${ROOT}/.venv/bin/pytest" -ra
