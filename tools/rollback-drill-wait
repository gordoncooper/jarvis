#!/usr/bin/env bash
# Poll the P0a rollback-drill ConfigMap until drill_token matches EXPECTED, logging to LOG_FILE.
set -euo pipefail

usage() {
  echo "usage: $0 EXPECTED_VALUE LOG_FILE" >&2
  echo "  optional env: JARVIS_ROLLBACK_NAMESPACE JARVIS_ROLLBACK_CONFIGMAP JARVIS_ROLLBACK_KEY" >&2
  echo "               JARVIS_ROLLBACK_TIMEOUT_SEC (default 600) JARVIS_ROLLBACK_INTERVAL_SEC (default 5)" >&2
  echo "               JARVIS_ROLLBACK_KUSTOMIZATION (default platform-configs)" >&2
  exit 2
}

if [[ $# -ne 2 ]]; then
  usage
fi

expected="$1"
log_file="$2"

namespace="${JARVIS_ROLLBACK_NAMESPACE:-platform-backups}"
configmap="${JARVIS_ROLLBACK_CONFIGMAP:-p0a-rollback-drill}"
data_key="${JARVIS_ROLLBACK_KEY:-drill_token}"
kustomization="${JARVIS_ROLLBACK_KUSTOMIZATION:-platform-configs}"
timeout_sec="${JARVIS_ROLLBACK_TIMEOUT_SEC:-600}"
interval_sec="${JARVIS_ROLLBACK_INTERVAL_SEC:-5}"

if ! [[ "$timeout_sec" =~ ^[0-9]+$ ]] || ! [[ "$interval_sec" =~ ^[0-9]+$ ]]; then
  echo "rollback-drill-wait: timeout and interval must be non-negative integers" >&2
  exit 2
fi

mkdir -p "$(dirname "$log_file")"

flux_revision() {
  kubectl get kustomization "$kustomization" -n flux-system \
    -o jsonpath='{.status.lastAppliedRevision}' 2>/dev/null || true
}

read_token() {
  kubectl get configmap "$configmap" -n "$namespace" \
    -o "jsonpath={.data.${data_key}}" 2>/dev/null || true
}

deadline=$(( $(date +%s) + timeout_sec ))
while true; do
  token="$(read_token)"
  revision="$(flux_revision)"
  ts="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  printf '%s value=%s flux_kustomization_revision=%s\n' "$ts" "${token:-<missing>}" "${revision:-<unknown>}" >>"$log_file"
  if [[ "$token" == "$expected" ]]; then
    printf '%s reached value=%s flux_kustomization_revision=%s\n' \
      "$ts" "$expected" "${revision:-<unknown>}" >>"$log_file"
    exit 0
  fi
  now=$(date +%s)
  if (( now >= deadline )); then
    echo "rollback-drill-wait: timed out after ${timeout_sec}s waiting for ${data_key}=${expected} (last=${token:-<missing>})" >&2
    exit 1
  fi
  sleep "$interval_sec"
done
