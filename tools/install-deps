def install_age(versions: dict[str, str], arch: str, dest_dir: Path) -> None:
    version = versions["age_version"]
    age_dest = dest_dir / "age"
    keygen_dest = dest_dir / "age-keygen"
    age_ok = age_installed_version(age_dest) == version
    keygen_ok = age_installed_version(keygen_dest) == version
    if age_ok:
        print(f"age {version} already installed at {age_dest}")
    if keygen_ok:
        print(f"age-keygen {version} already installed at {keygen_dest}")
    if age_ok and keygen_ok:
        return

    age_sha = versions[f"age_linux_{arch}_binary_sha256"]
    keygen_sha = versions[f"age_keygen_linux_{arch}_binary_sha256"]
    url = (
        f"https://github.com/FiloSottile/age/releases/download/v{version}/"
        f"age-v{version}-linux-{arch}.tar.gz"
    )
    with tempfile.TemporaryDirectory(prefix="jarvis-age-") as tmp:
        tarball = Path(tmp) / "age.tar.gz"
        print(f"downloading age {version} ({arch})…")
        download(url, tarball)
        with tarfile.open(tarball, "r:gz") as archive:
            archive.extract("age/age", path=tmp)
            archive.extract("age/age-keygen", path=tmp)
        age_src = Path(tmp) / "age" / "age"
        keygen_src = Path(tmp) / "age" / "age-keygen"
        if not age_ok:
            _install_verified_binary(
                src=age_src,
                dest=age_dest,
                expected_sha=age_sha,
                label="age",
                version=version,
            )
        if not keygen_ok:
            _install_verified_binary(
                src=keygen_src,
                dest=keygen_dest,
                expected_sha=keygen_sha,
                label="age-keygen",
                version=version,
            )


def _portable_node_bins(versions: dict[str, str]) -> tuple[Path, Path]:
    node_version = versions["nodejs_version"]
    arch = linux_arch()
    node_bin = NODE_DIR / "bin" / "node"
    npm_bin = NODE_DIR / "bin" / "npm"
    if node_bin.is_file() and npm_bin.is_file():
        installed = _installed_binary_version(node_bin, ["--version"])
        if installed == node_version:
            return node_bin, npm_bin

    tar_arch = "x64" if arch == "amd64" else "arm64"
    sha_key = f"nodejs_linux_{arch}_tarball_sha256"
    expected_sha = versions[sha_key]
    url = (
        f"https://nodejs.org/dist/v{node_version}/"
        f"node-v{node_version}-linux-{tar_arch}.tar.xz"
    )
    member = f"node-v{node_version}-linux-{tar_arch}"
    print(f"downloading node.js {node_version} ({tar_arch})…")
    with tempfile.TemporaryDirectory(prefix="jarvis-node-") as tmp:
        tarball = Path(tmp) / "node.tar.xz"
        download(url, tarball)
        verify_sha256(tarball, expected_sha, "node.js archive")
        if NODE_DIR.exists():
            shutil.rmtree(NODE_DIR)
        NODE_DIR.mkdir(parents=True, exist_ok=True)
        with tarfile.open(tarball, "r:xz") as archive:
            archive.extractall(path=NODE_DIR)
        extracted = NODE_DIR / member
        for child in extracted.iterdir():
            shutil.move(str(child), NODE_DIR / child.name)
        shutil.rmtree(extracted)
    if not node_bin.is_file() or not npm_bin.is_file():
        raise SystemExit(f"portable node install failed under {NODE_DIR}")
    return node_bin, npm_bin


def renovate_package_version() -> str:
    package_json = RENOVATE_DIR / "package.json"
    try:
        data = json.loads(package_json.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as err:
        raise SystemExit(f"invalid {package_json}: {err}") from err
    version = data.get("dependencies", {}).get("renovate")
    if not isinstance(version, str) or not version:
        raise SystemExit(f"missing dependencies.renovate in {package_json}")
    return version


def package_lock_sha256(lockfile: Path = RENOVATE_PACKAGE_LOCK) -> str:
    return sha256_file(lockfile)


def read_lock_marker(marker: Path = RENOVATE_LOCK_MARKER) -> str | None:
    if not marker.is_file():
        return None
    text = marker.read_text(encoding="utf-8").strip()
    return text or None


def write_lock_marker(digest: str, marker: Path = RENOVATE_LOCK_MARKER) -> None:
    marker.parent.mkdir(parents=True, exist_ok=True)
    marker.write_text(f"{digest}\n", encoding="utf-8")


def renovate_npm_ci_up_to_date(
    *,
    expected_version: str,
    installed_version: str | None,
    lock_sha256: str,
    marker_sha256: str | None,
    validator_exists: bool,
) -> bool:
    if installed_version != expected_version:
        return False
    if not validator_exists:
        return False
    if marker_sha256 is None:
        return False
    return marker_sha256 == lock_sha256


def renovate_installed_version(modules_dir: Path) -> str | None:
    package_json = modules_dir / "renovate" / "package.json"
    if not package_json.is_file():
        return None
    try:
        data = json.loads(package_json.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    version = data.get("version")
    return version if isinstance(version, str) else None


def _renovate_validator_script(modules_dir: Path) -> Path:
    for candidate in (
        modules_dir / "renovate" / "dist" / "config-validator.js",
        modules_dir / "renovate" / "dist" / "config-validator",
    ):
        if candidate.is_file():
            return candidate
    raise SystemExit(f"renovate config validator not found under {modules_dir}")


def install_renovate_config_validator(versions: dict[str, str]) -> None:
    version = versions["renovate_version"]
    package_version = renovate_package_version()
    if version != package_version:
        raise SystemExit(
            "renovate_version in tools/versions.env "
            f"({version}) does not match tools/renovate/package.json ({package_version})"
        )
    dest = INSTALL_DIR / "renovate-config-validator"
    installed = renovate_installed_version(RENOVATE_NODE_MODULES)
    lock_sha = package_lock_sha256()
    if renovate_npm_ci_up_to_date(
        expected_version=version,
        installed_version=installed,
        lock_sha256=lock_sha,
        marker_sha256=read_lock_marker(),
        validator_exists=dest.is_file(),
    ):
        print(f"renovate {version} already installed (renovate-config-validator at {dest})")
        return

    node_bin, npm_bin = _portable_node_bins(versions)

    print(f"installing renovate {version} from {RENOVATE_DIR}/package-lock.json…")
    env = os.environ.copy()
    env["PATH"] = f"{NODE_DIR / 'bin'}:{env.get('PATH', '')}"
    subprocess.run(
        [str(npm_bin), "ci", "--no-audit", "--no-fund"],
        cwd=RENOVATE_DIR,
        check=True,
        env=env,
    )
    write_lock_marker(lock_sha)

    validator_src = _renovate_validator_script(RENOVATE_NODE_MODULES)
    INSTALL_DIR.mkdir(parents=True, exist_ok=True)
    dest.write_text(
        f"""#!/usr/bin/env bash
set -euo pipefail
exec "{node_bin}" "{validator_src}" "$@"
""",
        encoding="utf-8",
    )
    os.chmod(dest, 0o755)
    print(f"installed renovate-config-validator {version} -> {dest}")


def main() -> None:
    if sys.platform != "linux":
        raise SystemExit("install-deps supports linux only")
    require_system_tools()
    versions = load_versions(VERSIONS_FILE)
    arch = linux_arch()
    install_sops(versions, arch, INSTALL_DIR)
    install_age(versions, arch, INSTALL_DIR)
    install_gitleaks(versions, arch, INSTALL_DIR)
    install_kustomize(versions, arch, INSTALL_DIR)
    install_kubeconform(versions, arch, INSTALL_DIR)
    install_helm(versions, arch, INSTALL_DIR)
    install_renovate_config_validator(versions)
    print(f"done; ensure {INSTALL_DIR} is on PATH")


if __name__ == "__main__":
    main()
