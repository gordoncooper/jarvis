#!/usr/bin/env python3
"""Install pinned sops, age, age-keygen, gitleaks, kustomize, kubeconform, and kubectl into ~/.local/bin."""

from __future__ import annotations

import hashlib
import os
import platform
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.request
from collections.abc import Callable
from dataclasses import dataclass
from pathlib import Path

TOOLS_DIR = Path(__file__).resolve().parent
VERSIONS_FILE = TOOLS_DIR / "versions.env"
INSTALL_DIR = Path.home() / ".local" / "bin"


def load_versions(path: Path) -> dict[str, str]:
    versions: dict[str, str] = {}
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        key, sep, value = line.partition("=")
        if not sep:
            raise SystemExit(f"invalid line in {path}: {raw!r}")
        versions[key.strip()] = value.strip()
    return versions


def linux_arch() -> str:
    machine = platform.machine().lower()
    if machine in ("x86_64", "amd64"):
        return "amd64"
    if machine in ("aarch64", "arm64"):
        return "arm64"
    raise SystemExit(f"unsupported linux architecture: {platform.machine()}")


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def verify_sha256(path: Path, expected: str, label: str) -> None:
    actual = sha256_file(path)
    if actual != expected.lower():
        raise SystemExit(
            f"{label}: sha256 mismatch (expected {expected}, got {actual})"
        )


def _python_probe(*, code: str) -> bool:
    if shutil.which("python3") is None:
        return False
    try:
        subprocess.run(
            ["python3", "-c", code],
            check=True,
            capture_output=True,
        )
    except subprocess.CalledProcessError:
        return False
    return True


def _missing_apt_packages() -> list[str]:
    missing: list[str] = []
    if shutil.which("openssl") is None:
        missing.append("openssl")
    if shutil.which("python3") is None:
        missing.extend(["python3", "python3-yaml", "python3-venv"])
    else:
        if not _python_probe(code="import yaml"):
            missing.append("python3-yaml")
        if not _python_probe(code="import ensurepip"):
            missing.append("python3-venv")
        if not _python_probe(code="import bcrypt"):
            missing.append("python3-bcrypt")
    return missing


def _apt_install_command(packages: list[str]) -> str:
    return "sudo apt-get install -y " + " ".join(packages)


def _try_apt_install(packages: list[str]) -> None:
    subprocess.run(
        ["sudo", "apt-get", "install", "-y", *packages],
        check=True,
    )


def require_system_tools() -> None:
    missing = _missing_apt_packages()
    if not missing:
        return
    if shutil.which("apt-get") and shutil.which("sudo"):
        print(f"installing missing packages: {' '.join(missing)}")
        try:
            _try_apt_install(missing)
        except subprocess.CalledProcessError as err:
            raise SystemExit(
                f"apt-get install failed (exit {err.returncode}); try:\n"
                f"  {_apt_install_command(missing)}"
            ) from err
        missing = _missing_apt_packages()
    if missing:
        raise SystemExit(
            "missing system packages; install with:\n"
            f"  {_apt_install_command(missing)}"
        )


def installed_version(bin_path: Path, version_args: list[str]) -> str | None:
    if not bin_path.is_file():
        return None
    try:
        proc = subprocess.run(
            [str(bin_path), *version_args],
            check=True,
            capture_output=True,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return None
    match = re.search(r"(\d+\.\d+\.\d+)", proc.stdout.strip() or proc.stderr.strip())
    return match.group(1) if match else None


def download(url: str, dest: Path) -> None:
    dest.parent.mkdir(parents=True, exist_ok=True)
    with urllib.request.urlopen(url) as response, dest.open("wb") as handle:
        shutil.copyfileobj(response, handle)


def _install_binary(src: Path, dest: Path, expected_sha: str, label: str, version: str) -> None:
    verify_sha256(src, expected_sha, label)
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(src, dest)
    os.chmod(dest, 0o755)
    print(f"installed {label} {version} -> {dest}")


@dataclass(frozen=True)
class TarballSpec:
    version_key: str
    version_args: tuple[str, ...]
    url: Callable[[str, str], str]
    member: str
    tar_arch: Callable[[str], str] = lambda arch: arch


TARBALL_INSTALLS: dict[str, TarballSpec] = {
    "kustomize": TarballSpec(
        version_key="kustomize_version",
        version_args=("version", "--short"),
        url=lambda v, arch: (
            "https://github.com/kubernetes-sigs/kustomize/releases/download/"
            f"kustomize%2Fv{v}/kustomize_v{v}_linux_{arch}.tar.gz"
        ),
        member="kustomize",
    ),
    "kubeconform": TarballSpec(
        version_key="kubeconform_version",
        version_args=("-v",),
        url=lambda v, arch: (
            f"https://github.com/yannh/kubeconform/releases/download/v{v}/"
            f"kubeconform-linux-{arch}.tar.gz"
        ),
        member="kubeconform",
    ),
    "gitleaks": TarballSpec(
        version_key="gitleaks_version",
        version_args=("version",),
        url=lambda v, arch: (
            f"https://github.com/gitleaks/gitleaks/releases/download/v{v}/"
            f"gitleaks_{v}_linux_{'x64' if arch == 'amd64' else arch}.tar.gz"
        ),
        member="gitleaks",
        tar_arch=lambda arch: "x64" if arch == "amd64" else arch,
    ),
}


def install_sops(versions: dict[str, str], arch: str, dest_dir: Path) -> None:
    version = versions["sops_version"]
    dest = dest_dir / "sops"
    if installed_version(dest, ["--version"]) == version:
        print(f"sops {version} already installed at {dest}")
        return

    sha_key = f"sops_linux_{arch}_binary_sha256"
    url = (
        f"https://github.com/getsops/sops/releases/download/v{version}/"
        f"sops-v{version}.linux.{arch}"
    )
    with tempfile.TemporaryDirectory(prefix="jarvis-sops-") as tmp:
        binary = Path(tmp) / "sops"
        print(f"downloading sops {version} ({arch})…")
        download(url, binary)
        _install_binary(binary, dest, versions[sha_key], "sops", version)


def install_tarball_cli(
    name: str, spec: TarballSpec, versions: dict[str, str], arch: str, dest_dir: Path
) -> None:
    version = versions[spec.version_key]
    dest = dest_dir / name
    if installed_version(dest, list(spec.version_args)) == version:
        print(f"{name} {version} already installed at {dest}")
        return

    tar_arch = spec.tar_arch(arch)
    sha_key = f"{name}_linux_{arch}_tarball_sha256"
    url = spec.url(version, tar_arch)
    with tempfile.TemporaryDirectory(prefix=f"jarvis-{name}-") as tmp:
        tarball = Path(tmp) / f"{name}.tar.gz"
        print(f"downloading {name} {version} ({tar_arch})…")
        download(url, tarball)
        verify_sha256(tarball, versions[sha_key], f"{name} archive")
        with tarfile.open(tarball, "r:gz") as archive:
            archive.extract(spec.member, path=tmp)
        binary = Path(tmp) / spec.member
        dest_dir.mkdir(parents=True, exist_ok=True)
        shutil.copy2(binary, dest)
        os.chmod(dest, 0o755)
        print(f"installed {name} {version} -> {dest}")


def install_kubectl(versions: dict[str, str], arch: str, dest_dir: Path) -> None:
    version = versions["kubectl_version"]
    dest = dest_dir / "kubectl"
    if installed_version(dest, ["version", "--client"]) == version:
        print(f"kubectl {version} already installed at {dest}")
        return

    sha_key = f"kubectl_linux_{arch}_binary_sha256"
    url = f"https://dl.k8s.io/release/v{version}/bin/linux/{arch}/kubectl"
    with tempfile.TemporaryDirectory(prefix="jarvis-kubectl-") as tmp:
        binary = Path(tmp) / "kubectl"
        print(f"downloading kubectl {version} ({arch})…")
        download(url, binary)
        _install_binary(binary, dest, versions[sha_key], "kubectl", version)


def install_age(versions: dict[str, str], arch: str, dest_dir: Path) -> None:
    version = versions["age_version"]
    age_dest = dest_dir / "age"
    keygen_dest = dest_dir / "age-keygen"
    age_ok = installed_version(age_dest, ["--version"]) == version
    keygen_ok = installed_version(keygen_dest, ["--version"]) == version
    if age_ok:
        print(f"age {version} already installed at {age_dest}")
    if keygen_ok:
        print(f"age-keygen {version} already installed at {keygen_dest}")
    if age_ok and keygen_ok:
        return

    url = (
        f"https://github.com/FiloSottile/age/releases/download/v{version}/"
        f"age-v{version}-linux-{arch}.tar.gz"
    )
    with tempfile.TemporaryDirectory(prefix="jarvis-age-") as tmp:
        tarball = Path(tmp) / "age.tar.gz"
        print(f"downloading age {version} ({arch})…")
        download(url, tarball)
        with tarfile.open(tarball, "r:gz") as archive:
            archive.extract("age/age", path=tmp)
            archive.extract("age/age-keygen", path=tmp)
        if not age_ok:
            _install_binary(
                Path(tmp) / "age" / "age",
                age_dest,
                versions[f"age_linux_{arch}_binary_sha256"],
                "age",
                version,
            )
        if not keygen_ok:
            _install_binary(
                Path(tmp) / "age" / "age-keygen",
                keygen_dest,
                versions[f"age_keygen_linux_{arch}_binary_sha256"],
                "age-keygen",
                version,
            )


def main() -> None:
    if sys.platform != "linux":
        raise SystemExit("install-deps supports linux only")
    require_system_tools()
    versions = load_versions(VERSIONS_FILE)
    arch = linux_arch()
    install_sops(versions, arch, INSTALL_DIR)
    install_age(versions, arch, INSTALL_DIR)
    install_kubectl(versions, arch, INSTALL_DIR)
    for cli_name, spec in TARBALL_INSTALLS.items():
        install_tarball_cli(cli_name, spec, versions, arch, INSTALL_DIR)
    print(f"done; ensure {INSTALL_DIR} is on PATH")


if __name__ == "__main__":
    main()
