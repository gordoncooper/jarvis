#!/usr/bin/env python3
"""Create-if-missing SOPS bootstrap secrets for an env (R7, R25). Never overwrites."""

from __future__ import annotations

import argparse
import base64
import hashlib
import os
import secrets
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path
from typing import Callable

import yaml

REPO_ROOT = Path(__file__).resolve().parents[1]
DEFAULT_ENV = "env-01"

SOPS_VERSION = "3.10.2"
AGE_VERSION = "1.2.1"
SOPS_RELEASE = f"v{SOPS_VERSION}"
AGE_RELEASE = f"v{AGE_VERSION}"

_SCRYPT_N = 2**14
_SCRYPT_R = 8
_SCRYPT_P = 1
_SCRYPT_DKLEN = 32
_SCRYPT_SALT_BYTES = 16

CA_DAYS = 3650


@dataclass(frozen=True)
class SecretSpec:
    filename: str
    build: Callable[[], dict]


def _repo_root() -> Path:
    return REPO_ROOT


def _secrets_dir(env: str) -> Path:
    return _repo_root() / "envs" / env / "secrets"


def _hash_password(password: str) -> str:
    """Hermes basic-auth scrypt format (plugins.dashboard_auth.basic.hash_password)."""
    salt = secrets.token_bytes(_SCRYPT_SALT_BYTES)
    dk = hashlib.scrypt(
        password.encode("utf-8"),
        salt=salt,
        n=_SCRYPT_N,
        r=_SCRYPT_R,
        p=_SCRYPT_P,
        dklen=_SCRYPT_DKLEN,
        maxmem=0,
    )
    salt_b64 = base64.b64encode(salt).decode()
    dk_b64 = base64.b64encode(dk).decode()
    return f"scrypt${_SCRYPT_N}${_SCRYPT_R}${_SCRYPT_P}${salt_b64}${dk_b64}"


def _random_token(nbytes: int = 32) -> str:
    return secrets.token_urlsafe(nbytes)


def _openssl_rand_base64(nbytes: int = 32) -> str:
    out = subprocess.check_output(["openssl", "rand", "-base64", str(nbytes)], text=True)
    return out.strip()


def _run_openssl(args: list[str], *, input_bytes: bytes | None = None) -> bytes:
    return subprocess.check_output(["openssl", *args], input=input_bytes)


def _generate_ca_material() -> tuple[str, str]:
    with tempfile.TemporaryDirectory() as tmp:
        key_path = Path(tmp) / "ca.key"
        crt_path = Path(tmp) / "ca.crt"
        _run_openssl(
            [
                "genpkey",
                "-algorithm",
                "RSA",
                "-pkeyopt",
                "rsa_keygen_bits:2048",
                "-out",
                str(key_path),
            ]
        )
        _run_openssl(
            [
                "req",
                "-x509",
                "-new",
                "-nodes",
                "-key",
                str(key_path),
                "-sha256",
                "-days",
                str(CA_DAYS),
                "-out",
                str(crt_path),
                "-subj",
                "/CN=jarvis-internal-ca/O=jarvis",
            ]
        )
        return crt_path.read_text(encoding="utf-8"), key_path.read_text(encoding="utf-8")


def _secret_doc(metadata: dict[str, str], string_data: dict[str, str]) -> dict:
    return {
        "apiVersion": "v1",
        "kind": "Secret",
        "metadata": metadata,
        "type": "Opaque",
        "stringData": string_data,
    }


def _tls_secret_doc(metadata: dict[str, str], cert_pem: str, key_pem: str) -> dict:
    return {
        "apiVersion": "v1",
        "kind": "Secret",
        "metadata": metadata,
        "type": "kubernetes.io/tls",
        "stringData": {"tls.crt": cert_pem, "tls.key": key_pem},
    }


def _hermes_dashboard_string_data() -> dict[str, str]:
    password = _random_token(24)
    return {
        "admin_password": password,
        "password_hash": _hash_password(password),
        "signing_secret": _openssl_rand_base64(32),
    }


def _specs() -> list[SecretSpec]:
    return [
        SecretSpec(
            "cert-manager-ca.sops.yaml",
            lambda: _tls_secret_doc(
                {"name": "cert-manager-ca", "namespace": "platform-cert-manager"},
                *_generate_ca_material(),
            ),
        ),
        SecretSpec(
            "backups-restic.sops.yaml",
            lambda: _secret_doc(
                {"name": "backups-restic", "namespace": "platform-backups"},
                {"restic_password": _random_token(32)},
            ),
        ),
        SecretSpec(
            "grafana-admin.sops.yaml",
            lambda: _secret_doc(
                {"name": "grafana-admin", "namespace": "observability"},
                {"admin_password": _random_token(24)},
            ),
        ),
        SecretSpec(
            "hermes-ops-api.sops.yaml",
            lambda: _secret_doc(
                {"name": "hermes-ops-api", "namespace": "hermes-ops"},
                {"api_server_key": _random_token(32)},
            ),
        ),
        SecretSpec(
            "hermes-ops-dashboard.sops.yaml",
            lambda: _secret_doc(
                {"name": "hermes-ops-dashboard", "namespace": "hermes-ops"},
                _hermes_dashboard_string_data(),
            ),
        ),
        SecretSpec(
            "hermes-code-factory-api.sops.yaml",
            lambda: _secret_doc(
                {"name": "hermes-code-factory-api", "namespace": "hermes-code-factory"},
                {"api_server_key": _random_token(32)},
            ),
        ),
        SecretSpec(
            "hermes-code-factory-dashboard.sops.yaml",
            lambda: _secret_doc(
                {"name": "hermes-code-factory-dashboard", "namespace": "hermes-code-factory"},
                _hermes_dashboard_string_data(),
            ),
        ),
    ]


def _ensure_tool(name: str, version: str, install_fn: Callable[[Path], None]) -> str:
    local_bin = Path.home() / ".local" / "bin"
    for directory in (local_bin, Path("/usr/local/bin"), Path("/usr/bin")):
        candidate = directory / name
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    local_bin.mkdir(parents=True, exist_ok=True)
    target = local_bin / name
    if not target.is_file():
        print(
            f"{name} not found on PATH; installing {version} to {target}",
            file=sys.stderr,
        )
        install_fn(target)
        target.chmod(0o755)
    return str(target)


def _install_age(target: Path) -> None:
    import tarfile
    import urllib.request

    url = (
        f"https://github.com/FiloSottile/age/releases/download/{AGE_RELEASE}/"
        f"age-{AGE_VERSION}-linux-amd64.tar.gz"
    )
    with urllib.request.urlopen(url) as resp:
        with tarfile.open(fileobj=resp, mode="r|gz") as tar:
            for member in tar:
                if member.name.endswith("/age"):
                    extracted = tar.extractfile(member)
                    if extracted is None:
                        raise SystemExit("age binary missing from archive")
                    target.write_bytes(extracted.read())
                    return
    raise SystemExit("age binary not found in release archive")


def _install_sops(target: Path) -> None:
    import urllib.request

    url = (
        f"https://github.com/getsops/sops/releases/download/{SOPS_RELEASE}/"
        f"sops-{SOPS_VERSION}.linux.amd64"
    )
    with urllib.request.urlopen(url) as resp:
        target.write_bytes(resp.read())


def _resolve_tools() -> tuple[str, str]:
    sops = _ensure_tool("sops", SOPS_VERSION, _install_sops)
    age = _ensure_tool("age", AGE_VERSION, _install_age)
    return sops, age


def _encrypt_file(path: Path, sops_bin: str) -> None:
    subprocess.check_call([sops_bin, "encrypt", "--in-place", str(path)], cwd=_repo_root())


def _write_encrypted(path: Path, document: dict, sops_bin: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", delete=False, dir=path.parent) as tmp:
        yaml.safe_dump(document, tmp, sort_keys=False)
        tmp_path = Path(tmp.name)
    try:
        tmp_path.replace(path)
        _encrypt_file(path, sops_bin)
    finally:
        if tmp_path.exists():
            tmp_path.unlink(missing_ok=True)


def bootstrap(env: str, *, sops_bin: str | None = None) -> list[str]:
    created: list[str] = []
    sops = sops_bin or _resolve_tools()[0]
    for spec in _specs():
        path = _secrets_dir(env) / spec.filename
        if path.exists():
            continue
        _write_encrypted(path, spec.build(), sops)
        created.append(str(path.relative_to(_repo_root())))
    return created


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--env", default=DEFAULT_ENV, help=f"Env under envs/ (default: {DEFAULT_ENV})")
    args = parser.parse_args(argv)
    created = bootstrap(args.env)
    if created:
        for rel in created:
            print(f"created {rel}")
    else:
        print("bootstrap-secrets: all files present; nothing changed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
