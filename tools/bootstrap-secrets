#!/usr/bin/env python3
"""Create-if-missing SOPS bootstrap secrets for an env (R7, R25). Never overwrites."""

from __future__ import annotations

import argparse
import base64
import hashlib
import secrets
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path
from typing import Callable

import bcrypt

_TOOLS_LIB = Path(__file__).resolve().parent / "lib"
if str(_TOOLS_LIB) not in sys.path:
    sys.path.insert(0, str(_TOOLS_LIB))

import _sops  # noqa: E402

REPO_ROOT = Path(__file__).resolve().parents[1]

_SCRYPT_N = 2**14
_SCRYPT_R = 8
_SCRYPT_P = 1
_SCRYPT_DKLEN = 32
_SCRYPT_SALT_BYTES = 16

CA_DAYS = 3650

# One htpasswd user. The password stays out of the repository URL.
RESTIC_REST_USERNAME = "restic"
# Server prefix. A volume repository is this plus "ns-<namespace>/pvc-<pvc>".
# Those prefixes keep a segment off rest-server's reserved names
# (data, index, keys, locks, snapshots, config).
RESTIC_REPOSITORY = "rest:http://restic.platform-backups.svc.cluster.local:8000/"


@dataclass(frozen=True)
class SecretSpec:
    filename: str
    build: Callable[[], dict]


def _repo_root() -> Path:
    return REPO_ROOT


def _secrets_dir(env: str) -> Path:
    return _repo_root() / "envs" / env / "secrets"


def _hash_password(password: str) -> str:
    """Hermes basic-auth scrypt format (plugins.dashboard_auth.basic.hash_password)."""
    salt = secrets.token_bytes(_SCRYPT_SALT_BYTES)
    dk = hashlib.scrypt(
        password.encode("utf-8"),
        salt=salt,
        n=_SCRYPT_N,
        r=_SCRYPT_R,
        p=_SCRYPT_P,
        dklen=_SCRYPT_DKLEN,
        maxmem=0,
    )
    salt_b64 = base64.b64encode(salt).decode()
    dk_b64 = base64.b64encode(dk).decode()
    return f"scrypt${_SCRYPT_N}${_SCRYPT_R}${_SCRYPT_P}${salt_b64}${dk_b64}"


def _random_token(nbytes: int = 32) -> str:
    return secrets.token_urlsafe(nbytes)


def _openssl_rand_base64(nbytes: int = 32) -> str:
    out = subprocess.check_output(["openssl", "rand", "-base64", str(nbytes)], text=True)
    return out.strip()


def _run_openssl(args: list[str], *, input_bytes: bytes | None = None) -> bytes:
    result = subprocess.run(
        ["openssl", *args],
        input=input_bytes,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        sys.stderr.write(result.stderr.decode("utf-8", errors="replace"))
        raise subprocess.CalledProcessError(result.returncode, ["openssl", *args])
    return result.stdout


def _generate_ca_material() -> tuple[str, str]:
    with tempfile.TemporaryDirectory() as tmp:
        key_path = Path(tmp) / "ca.key"
        crt_path = Path(tmp) / "ca.crt"
        _run_openssl(
            [
                "genpkey",
                "-algorithm",
                "RSA",
                "-pkeyopt",
                "rsa_keygen_bits:2048",
                "-out",
                str(key_path),
            ]
        )
        _run_openssl(
            [
                "req",
                "-x509",
                "-new",
                "-nodes",
                "-key",
                str(key_path),
                "-sha256",
                "-days",
                str(CA_DAYS),
                "-out",
                str(crt_path),
                "-subj",
                "/CN=jarvis-internal-ca/O=jarvis",
            ]
        )
        return crt_path.read_text(encoding="utf-8"), key_path.read_text(encoding="utf-8")


def _secret_doc(metadata: dict[str, str], string_data: dict[str, str]) -> dict:
    return {
        "apiVersion": "v1",
        "kind": "Secret",
        "metadata": metadata,
        "type": "Opaque",
        "stringData": string_data,
    }


def _tls_secret_doc(metadata: dict[str, str], cert_pem: str, key_pem: str) -> dict:
    return {
        "apiVersion": "v1",
        "kind": "Secret",
        "metadata": metadata,
        "type": "kubernetes.io/tls",
        "stringData": {"tls.crt": cert_pem, "tls.key": key_pem},
    }


def _htpasswd_line(username: str, password: str) -> str:
    if not username or any(char in username for char in ":\r\n") or any(
        char in password for char in "\r\n\x00"
    ):
        raise SystemExit("refusing to build an htpasswd line")
    hashed = bcrypt.hashpw(password.encode("utf-8"), bcrypt.gensalt(rounds=12)).decode("ascii")
    return f"{username}:{hashed}\n"


def _htpasswd_accepts(line: str, username: str, password: str) -> bool:
    user, sep, hashed = line.strip().partition(":")
    if not sep or user != username or not hashed.startswith("$2"):
        return False
    try:
        return bcrypt.checkpw(password.encode("utf-8"), hashed.encode("ascii"))
    except ValueError:
        return False


def _restic_string_data() -> dict[str, str]:
    rest_password = _random_token(32)
    return {
        "RESTIC_PASSWORD": _random_token(32),
        "RESTIC_REPOSITORY": RESTIC_REPOSITORY,
        "RESTIC_REST_USERNAME": RESTIC_REST_USERNAME,
        "RESTIC_REST_PASSWORD": rest_password,
        "htpasswd": _htpasswd_line(RESTIC_REST_USERNAME, rest_password),
    }


def _hermes_dashboard_string_data() -> dict[str, str]:
    password = _random_token(24)
    return {
        "admin_password": password,
        "password_hash": _hash_password(password),
        "signing_secret": _openssl_rand_base64(32),
    }


def _specs() -> list[SecretSpec]:
    return [
        SecretSpec(
            "cert-manager-ca.sops.yaml",
            lambda: _tls_secret_doc(
                {"name": "cert-manager-ca", "namespace": "platform-cert-manager"},
                *_generate_ca_material(),
            ),
        ),
        SecretSpec(
            "backups-restic.sops.yaml",
            lambda: _secret_doc(
                {"name": "backups-restic", "namespace": "platform-backups"},
                _restic_string_data(),
            ),
        ),
        SecretSpec(
            "grafana-admin.sops.yaml",
            lambda: _secret_doc(
                {"name": "grafana-admin", "namespace": "observability"},
                {"admin_password": _random_token(24)},
            ),
        ),
        SecretSpec(
            "hermes-ops-api.sops.yaml",
            lambda: _secret_doc(
                {"name": "hermes-ops-api", "namespace": "hermes-ops"},
                {"api_server_key": _random_token(32)},
            ),
        ),
        SecretSpec(
            "hermes-ops-dashboard.sops.yaml",
            lambda: _secret_doc(
                {"name": "hermes-ops-dashboard", "namespace": "hermes-ops"},
                _hermes_dashboard_string_data(),
            ),
        ),
        SecretSpec(
            "hermes-code-factory-api.sops.yaml",
            lambda: _secret_doc(
                {"name": "hermes-code-factory-api", "namespace": "hermes-code-factory"},
                {"api_server_key": _random_token(32)},
            ),
        ),
        SecretSpec(
            "hermes-code-factory-dashboard.sops.yaml",
            lambda: _secret_doc(
                {"name": "hermes-code-factory-dashboard", "namespace": "hermes-code-factory"},
                _hermes_dashboard_string_data(),
            ),
        ),
    ]


def _write_encrypted(path: Path, document: dict, sops_bin: str) -> None:
    _sops.encrypt_secret_to_file(
        repo_root=_repo_root(),
        destination=path,
        document=document,
        sops_bin=sops_bin,
    )


def bootstrap(env: str, *, sops_bin: str | None = None) -> list[str]:
    created: list[str] = []
    sops = sops_bin or _sops.require_sops()
    for spec in _specs():
        path = _secrets_dir(env) / spec.filename
        if path.exists():
            continue
        _write_encrypted(path, spec.build(), sops)
        created.append(str(path.relative_to(_repo_root())))
    return created


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--env", required=True, help="Env under envs/")
    args = parser.parse_args(argv)
    created = bootstrap(args.env)
    if created:
        for rel in created:
            print(f"created {rel}")
    else:
        print("bootstrap-secrets: all files present; nothing changed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
