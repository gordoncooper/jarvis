#!/usr/bin/env python3
"""Validate hosted app folders: python3 tools/app-check <folder>... (platform/app-hosting/CONTRACT.md).

The apps repository's CI checks out this repository at a pinned commit and runs this on
each changed app folder. It needs Python 3 with PyYAML, and kustomize when deploy/ holds a
kustomization.yaml. Exit 1 lists every problem.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from _app_file import check_folder  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("folders", nargs="+", type=Path, help="App folders, each <name>/ holding app.yaml and deploy/")
    args = parser.parse_args(argv)
    problems = [problem for folder in args.folders for problem in check_folder(folder)]
    for problem in problems:
        print(problem)
    if not problems:
        print(f"app-check: {len(args.folders)} app folder(s) OK")
    return 1 if problems else 0


if __name__ == "__main__":
    raise SystemExit(main())
