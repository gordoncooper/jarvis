#!/usr/bin/env bash
# P0a live verify: fail when zero Flux objects are found.
set -euo pipefail

if ! command -v kubectl >/dev/null 2>&1; then
  echo "kubectl not found; install it or run from a node with kubeconfig" >&2
  exit 1
fi

flux_count="$(kubectl get kustomizations,gitrepositories -A --no-headers 2>/dev/null | wc -l)"
if [[ "${flux_count}" -eq 0 ]]; then
  echo "no Flux objects found (expected at least one Kustomization or GitRepository)" >&2
  exit 1
fi
echo "Flux objects: ${flux_count}"
