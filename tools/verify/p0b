#!/usr/bin/env python3
"""Read-only P0b exit check (make verify PHASE=p0b ENV=<env> DRILL_LOG=<file>)."""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
from collections.abc import Callable
from pathlib import Path
from subprocess import CompletedProcess

import yaml

REPO_ROOT = Path(__file__).resolve().parents[2]
_HASH = re.compile(r"\b[0-9a-f]{64}\b")
# sha256sum labels the volume checksum with the drill file. An image digest is not that line.
_VOLUME_SUM = re.compile(r"^([0-9a-f]{64})  /data/payload$")
_PVC_DELETED = re.compile(r'persistentvolumeclaim "[^"]+" deleted')
_RESTORE = re.compile(r"\brestore\b")
_SNAPSHOT = re.compile(r"etcd-snapshot-\S+")
_TIMEOUT_SECONDS = 30

Fetch = Callable[[str], tuple[int, str]]
Issuer = Callable[[str], tuple[int, str]]


def _line(text: str) -> None:
    print(text, flush=True)


def _tool_env() -> dict[str, str]:
    env = os.environ.copy()
    prefix = os.pathsep.join(
        (
            str(REPO_ROOT / ".venv" / "bin"),
            str(Path.home() / ".local" / "bin"),
        )
    )
    env["PATH"] = prefix + os.pathsep + env.get("PATH", "")
    return env


def _run(argv: list[str], *, input: str | None = None) -> CompletedProcess[str]:
    try:
        return subprocess.run(
            argv,
            input=input,
            env=_tool_env(),
            capture_output=True,
            text=True,
            timeout=_TIMEOUT_SECONDS,
            check=False,
        )
    except FileNotFoundError:
        _line(f"{argv[0]} not found")
        raise SystemExit(1) from None
    except subprocess.TimeoutExpired:
        _line(f"{argv[0]} timed out")
        raise SystemExit(1) from None


def _fetch(host: str) -> tuple[int, str]:
    proc = _run(["curl", "-fsS", "--max-time", str(_TIMEOUT_SECONDS), f"https://{host}/"])
    if proc.returncode != 0:
        err = (proc.stderr or proc.stdout or "curl failed").strip()
        return 1, err.splitlines()[0] if err else "curl failed"
    return 0, proc.stdout


def _issuer(host: str) -> tuple[int, str]:
    client = _run(
        [
            "openssl",
            "s_client",
            "-connect",
            f"{host}:443",
            "-servername",
            host,
            "-verify_return_error",
        ],
        input="",
    )
    if client.returncode != 0:
        err = (client.stderr or "certificate verify failed").strip()
        return 1, err.splitlines()[0] if err else "certificate verify failed"
    cert = _run(["openssl", "x509", "-noout", "-issuer"], input=client.stdout)
    if cert.returncode != 0 or not cert.stdout.strip():
        return 1, "no certificate issuer"
    return 0, cert.stdout.strip()


def etcd_checksum_matches(text: str) -> bool:
    """The k3s snapshot file and the copy restored from restic share one sha256."""
    counts: dict[str, int] = {}
    for line in text.splitlines():
        if not _SNAPSHOT.search(line):
            continue
        for digest in _HASH.findall(line):
            counts[digest] = counts.get(digest, 0) + 1
    return any(count >= 2 for count in counts.values())


def recorded_checksum(text: str) -> str | None:
    """Volume checksum, the PVC deletion, a restore, the same checksum, and the etcd pair."""
    first: str | None = None
    deleted = False
    restored = False
    for line in text.splitlines():
        if _SNAPSHOT.search(line):
            continue
        match = _VOLUME_SUM.match(line.strip())
        if first is None:
            if match:
                first = match.group(1)
            continue
        if _PVC_DELETED.search(line):
            deleted = True
        if deleted and _RESTORE.search(line):
            restored = True
        if restored and match is not None and match.group(1) == first and etcd_checksum_matches(text):
            return first
    return None


def _print_checklist(host: str) -> int:
    _line("Owner checklist:")
    _line(f"- tailnet curl of https://{host}/ [G]:")
    return 1


def run(
    repo_root: Path,
    env: str,
    drill_log: Path,
    fetch: Fetch,
    issuer: Issuer,
) -> int:
    values = repo_root / "envs" / env / "values" / "cluster-vars.yaml"
    suffix = yaml.safe_load(values.read_text(encoding="utf-8"))["dns_suffix"]
    host = f"testapp.{suffix}"
    failed = 0
    code, body = fetch(host)
    if code != 0 or not body:
        _line(f"FAIL lan curl https://{host}/: {body or 'empty body'}")
        failed += 1
    else:
        _line(f"PASS lan curl https://{host}/")
        _line(body.rstrip("\n"))
    code, who = issuer(host)
    if code != 0 or not who:
        _line(f"FAIL cert issuer: {who or 'empty'}")
        failed += 1
    else:
        _line(f"PASS cert issuer {who}")
    try:
        text = drill_log.read_text(encoding="utf-8")
    except OSError as exc:
        _line(f"FAIL drill log: {exc.strerror or exc}")
        failed += 1
        text = ""
    else:
        checksum = recorded_checksum(text)
        if checksum is None:
            _line(
                "FAIL drill log: need the checksum, the PVC deletion, the restore,"
                " the same checksum, and a matching etcd snapshot checksum"
            )
            failed += 1
        else:
            _line(f"PASS restore checksum {checksum}")
    remaining = _print_checklist(host)
    if failed:
        return 1
    if remaining:
        _line(f"automatic checks passed; {remaining} owner items remain")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--env", required=True, help="Env under envs/")
    parser.add_argument("--drill-log", required=True, help="p0b-10 drill transcript")
    args = parser.parse_args(argv)
    return run(REPO_ROOT, args.env, Path(args.drill_log), _fetch, _issuer)


if __name__ == "__main__":
    sys.exit(main())
