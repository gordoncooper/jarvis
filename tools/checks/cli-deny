#!/usr/bin/env bash
# CI rule check: Cursor CLI deny list blocks cluster writes and secret decryption (R34).
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

export PYTHONPATH="${repo_root}/tools:${repo_root}${PYTHONPATH:+:${PYTHONPATH}}"

python3 - <<'PY'
import json
from pathlib import Path

from _cli_permissions import (
    DRY_RUN_MUST_ALLOW,
    DRY_RUN_MUST_BLOCK,
    DRY_RUN_MUST_BLOCK_READS,
    command_allowed,
    load_cli_permissions,
    read_allowed,
    run_dry_run,
    validate_deny_coverage,
)

cli_path = Path(".cursor/cli.json")
if not cli_path.is_file():
    print("missing .cursor/cli.json", flush=True)
    raise SystemExit(1)

try:
    json.loads(cli_path.read_text(encoding="utf-8"))
except json.JSONDecodeError as exc:
    print(f".cursor/cli.json is not valid JSON: {exc}", flush=True)
    raise SystemExit(1)

perms = load_cli_permissions(cli_path)
coverage_errors = validate_deny_coverage(perms["deny"])
if coverage_errors:
    for line in coverage_errors:
        print(line, flush=True)
    raise SystemExit(1)

allow, deny = perms["allow"], perms["deny"]
print(f"cli permissions dry-run ({cli_path})")
print(
    "matching: Shell(commandBase) or Shell(command:args); "
    "Read(pathOrGlob); globs * ? **; deny beats allow"
)
print()

print("must BLOCK (shell)")
for cmd in DRY_RUN_MUST_BLOCK:
    allowed = command_allowed(allow, deny, cmd)
    status = "ALLOW" if allowed else "BLOCK"
    print(f"  [{status}] {cmd}")
print()

print("must BLOCK (read)")
for read_path in DRY_RUN_MUST_BLOCK_READS:
    allowed = read_allowed(allow, deny, read_path)
    status = "ALLOW" if allowed else "BLOCK"
    print(f"  [{status}] Read({read_path})")
print()

print("must ALLOW (shell)")
for cmd in DRY_RUN_MUST_ALLOW:
    allowed = command_allowed(allow, deny, cmd)
    status = "ALLOW" if allowed else "BLOCK"
    print(f"  [{status}] {cmd}")
print()

failures, _ = run_dry_run(cli_path)
if failures:
    for line in failures:
        print(line, flush=True)
    raise SystemExit(1)
print("dry-run OK")
PY
