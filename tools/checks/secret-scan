#!/usr/bin/env bash
# CI rule check: pinned gitleaks secret scan (R25, framework §4).
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
gitleaks="${HOME}/.local/bin/gitleaks"

if [[ ! -x "$gitleaks" ]]; then
  echo "secret-scan: gitleaks not found at ${gitleaks} (run: make deps)" >&2
  exit 1
fi

cd "$repo_root"
exec "$gitleaks" detect --source "$repo_root" --redact
