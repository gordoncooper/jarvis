// Core in a container, for working on core: mise installs every pinned CLI (mise.lock) and uv the
// Python packages (uv.lock), through mise.toml's deps task, as CI does. An instance repository gets
// its own devcontainer from jarvis init (jarvis/kit/devcontainer/).
{
  "name": "jarvis core",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "containerEnv": {
    // renovate: datasource=github-releases depName=jdx/mise
    "MISE_VERSION": "v2026.11.5"
  },
  "postCreateCommand": "curl -fsSL https://mise.run | sh && ~/.local/bin/mise trust && ~/.local/bin/mise run deps && echo 'eval \"$(~/.local/bin/mise activate bash)\"' >> ~/.bashrc",
  "remoteUser": "vscode"
}
